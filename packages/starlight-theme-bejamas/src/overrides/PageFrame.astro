---
import MobileMenuToggle from "virtual:starlight/components/MobileMenuToggle";

const { hasSidebar } = Astro.locals.starlightRoute;
const { template } = Astro.locals.starlightRoute.entry.data;

// Splash templates disable Starlight's sidebar by default, but we still want
// the mobile menu toggle there to expose docs/components navigation.
const shouldRenderSidebarNav = hasSidebar || template === "splash";
const isSplashTemplate = template === "splash";
---

<div
  class:list={[
    "page sl-flex",
    shouldRenderSidebarNav && "page-has-sidebar-nav",
    isSplashTemplate && "page-mobile-sidebar-only",
  ]}
>
  <header class="header">
    <slot name="header" />
    <div class="fade"></div>
  </header>
  {
    shouldRenderSidebarNav && (
      <nav
        class:list={["sidebar print:hidden", isSplashTemplate && "sidebar-splash"]}
        aria-label={Astro.locals.t("sidebarNav.accessibleLabel")}
      >
        <MobileMenuToggle />
        <script>
          if (!customElements.get("sl-sidebar-pane")) {
            class StarlightSidebarPane extends HTMLElement {
              constructor() {
                super();

                const desktopMediaQuery = matchMedia("(min-width: 64rem)");
                const updatePopover = () => {
                  this.popover = desktopMediaQuery.matches ? null : "auto";
                };
                updatePopover();
                desktopMediaQuery.addEventListener("change", updatePopover);

                this.addEventListener("toggle", () => {
                  const isOpen = this.matches(":popover-open");
                  document
                    .querySelectorAll<HTMLElement>(".main-frame, .sl-skip-link")
                    .forEach((element) => element.toggleAttribute("inert", isOpen));

                  if (isOpen && this.closest(".sidebar-splash")) {
                    this.scrollTop = 0;
                  }
                });
              }
            }

            customElements.define("sl-sidebar-pane", StarlightSidebarPane);
          }
        </script>
        <sl-sidebar-pane popover="" id="starlight__sidebar" class="sidebar-pane">
          <div class="sidebar-content sl-flex">
            <slot name="sidebar" />
          </div>
        </sl-sidebar-pane>
      </nav>
    )
  }

  <div class:list={["main-frame", isSplashTemplate && "main-frame-splash"]}>
    {
      template === "splash" ? (
        <slot />
      ) : (
        <div class="main-frame-inner">
          <slot />
        </div>
      )
    }
  </div>
</div>

<style>
  @layer bejamas {
    .page {
      flex-direction: column;
    }

    .fade {
      --blur: 4px;
      --stop: 50%;
      --height: 72px;
      position: fixed;
      pointer-events: none;
      width: 100%;
      height: var(--height);
      user-select: none;
      -webkit-user-select: none;
      left: 0;
      -webkit-backdrop-filter: blur(var(--blur));
      backdrop-filter: blur(var(--blur));

      background: linear-gradient(
        to top,
        transparent,
        var(--sl-page-background)
      );
      mask-image: linear-gradient(
        to bottom,
        var(--sl-page-background) var(--stop),
        transparent
      );
      top: 0;
    }

    .header {
      z-index: var(--sl-z-index-navbar);
      position: fixed;
      inset-inline-start: 0;
      inset-block-start: 0;
      width: 100%;
      height: var(--sl-nav-height);
      /* border-bottom: 1px solid var(--sl-color-hairline-shade); */
      padding: var(--sl-nav-pad-y) var(--sl-nav-pad-x);
      padding-inline-end: var(--sl-nav-pad-x);
      /* background-color: var(--sl-color-bg-nav); */
    }

    .header {
      background-color: var(--background);
    }

    @media (min-width: 64rem) {
      .header {
        background-color: transparent;
      }
    }

    :global([data-has-sidebar]) .header,
    .page-has-sidebar-nav .header {
      padding-inline-end: calc(
        var(--sl-nav-gap) + var(--sl-nav-pad-x) + var(--sl-menu-button-size)
      );
    }

    .sidebar-pane {
      border: 0;
      margin: 0;
      color: inherit;
      display: none;
      position: fixed;
      z-index: var(--sl-z-index-menu);
      inset-block: var(--sl-nav-height) 0;
      inset-inline-start: 0;
      width: 100%;
      background-color: var(--background);
      height: calc(100svh - var(--sl-nav-height));
      overflow-y: scroll;
      overflow-x: hidden;
      scrollbar-width: none;
      scroll-behavior: auto;
      -webkit-overflow-scrolling: touch;
      overscroll-behavior: contain;
      overscroll-behavior-y: contain;
      padding: 0;
    }

    .sidebar-pane:popover-open {
      display: block;
    }

    .sidebar-content {
      height: 100%;
      min-height: max-content;
      padding: 1rem var(--sl-sidebar-pad-x) 0;
      flex-direction: column;
      gap: 1rem;
    }

    @media (min-width: 64rem) {
      .sidebar-content::after {
        content: "";
        padding-bottom: 1px;
      }

      .sidebar-pane {
        margin-top: calc(var(--spacing) * 18);
      }
    }

    .main-frame {
      padding-top: calc(var(--sl-nav-height) + var(--sl-mobile-toc-height));
      /* padding-inline-start: var(--sl-content-inline-start); */
    }

    .main-frame-splash {
      position: relative;
      isolation: isolate;
      --sl-splash-frame-top: calc(var(--spacing) * 8);
      --sl-splash-frame-inline: 0;
    }

    .main-frame-splash > * {
      position: relative;
      z-index: 1;
    }

    .main-frame-inner {
      position: relative;
      background-color: var(--sl-main-frame-inner-background);
      border: 1px solid var(--sl-main-frame-inner-border);
      border-bottom: 0;
      min-height: calc(100svh - var(--sl-nav-height));
      border-radius: calc(var(--radius) + 12px) calc(var(--radius) + 12px) 0 0;
      margin-inline: calc(var(--spacing) * 1);
      margin-top: calc(var(--spacing) * 4);
    }

    @media (min-width: 64rem) {
      .main-frame-inner {
        margin-inline: 0;
        margin-top: 0;
      }
    }

    @media (min-width: 48rem) {
      .main-frame-splash::before {
        content: "";
        position: absolute;
        inset-inline: var(--sl-splash-frame-inline);
        inset-block-start: var(--sl-splash-frame-top);
        inset-block-end: 0;
        border: 1px solid var(--sl-main-frame-inner-border);
        border-bottom: 0;
        border-radius: calc(var(--radius) + 12px) calc(var(--radius) + 12px) 0 0;
        background-color: var(--sl-main-frame-inner-background);
        pointer-events: none;
        z-index: 0;
      }

      /* Pages with their own local splash frame keep full control. */
      :global(.main-frame-splash:has(.page-bg))::before {
        content: none;
      }
    }

    /* .main-frame-inner::before,
    .main-frame-inner::after {
      content: "";
      position: absolute;
      width: 1px;
      height: calc(var(--spacing) * 18);
      background: linear-gradient(
        to bottom,
        var(--sl-main-frame-inner-border) 0%,
        var(--muted) 100%
      );
      bottom: 0;
    }

    .main-frame-inner::before {
      left: -1px;
    }

    .main-frame-inner::after {
      right: -1px;
    } */

    @media (min-width: 64rem) {
      .page-mobile-sidebar-only {
        --sl-sidebar-width: 0;
        --sl-content-inline-start: 0;
      }

      :global([data-has-sidebar]) .header,
      .page-has-sidebar-nav .header {
        padding-inline-end: var(--sl-nav-pad-x);
      }
      .sidebar-pane {
        display: block;
        width: var(--sl-sidebar-width);
        background-color: var(--sl-color-bg-sidebar);
        border-inline-end: 1px solid var(--sl-color-hairline-shade);
      }

      /* Keep splash templates desktop layout unchanged; only mobile gets menu panel. */
      .sidebar-splash .sidebar-pane {
        display: none;
      }
    }
  }
</style>
