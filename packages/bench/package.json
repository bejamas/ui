{
  "name": "@bejamas/bench",
  "version": "0.0.0",
  "description": "Compare an original site with its ported version: Lighthouse, route assets, accessibility, and visual parity.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "bejamas-bench": "./dist/cli.js"
  },
  "files": [
    "dist/"
  ],
  "keywords": [
    "benchmark",
    "lighthouse",
    "visual-regression",
    "migration",
    "bejamas"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "check-types": "tsc --noEmit",
    "prepublishOnly": "bun run build",
    "test": "bun run build && bun test"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/bejamas/ui.git",
    "directory": "packages/bench"
  },
  "bugs": "https://github.com/bejamas/ui/issues",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/pngjs": "6.0.5",
    "tsdown": "^0.23.0"
  },
  "dependencies": {
    "axe-core": "4.14.0",
    "chrome-launcher": "1.2.2",
    "commander": "^15.0.0",
    "kleur": "^4.1.5",
    "lighthouse": "13.5.0",
    "pixelmatch": "8.0.0",
    "playwright-core": "1.63.0",
    "pngjs": "7.0.0"
  }
}
