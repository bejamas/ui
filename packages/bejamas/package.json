{
  "name": "bejamas",
  "version": "0.4.2",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "default": "./dist/index.js"
    },
    "./tailwind.css": "./tailwind.css"
  },
  "bin": {
    "bejamas": "./dist/index.js"
  },
  "files": [
    "dist/",
    "tailwind.css",
    "src/tailwind.css"
  ],
  "keywords": [
    "components",
    "ui",
    "tailwind",
    "astro-ui",
    "astro-shadcn",
    "bejamas-ui",
    "bejamas"
  ],
  "engines": {
    "node": ">=20",
    "bun": ">=1.1.0"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "generate:schema": "bun run scripts/generate-schema.ts",
    "smoke:blocks:local": "bun run scripts/smoke-blocks-local.ts",
    "smoke:init:local": "bun run scripts/smoke-init-local.ts",
    "prepublishOnly": "bun run build",
    "test": "bun run build && bun test"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/bejamas/ui.git",
    "directory": "packages/bejamas"
  },
  "bugs": "https://github.com/bejamas/ui/issues",
  "devDependencies": {
    "@bejamas/create-config": "workspace:*",
    "@bejamas/registry": "workspace:*",
    "@bejamas/semantic-icons": "workspace:*",
    "tsdown": "^0.23.0"
  },
  "dependencies": {
    "@antfu/ni": "^30.6.0",
    "commander": "^15.0.0",
    "cosmiconfig": "^10.0.1",
    "dotenv": "^18.0.3",
    "execa": "^10.0.1",
    "fast-glob": "^3.3.3",
    "fs-extra": "^11.4.1",
    "kleur": "^4.1.5",
    "open": "^11.0.4",
    "ora": "^9.4.1",
    "prompts": "^2.4.2",
    "shadcn": "4.21.0",
    "tar": "^7.5.22",
    "ts-morph": "^28.0.0",
    "tsconfig-paths": "^4.2.0",
    "zod": "^4.6.5"
  }
}
