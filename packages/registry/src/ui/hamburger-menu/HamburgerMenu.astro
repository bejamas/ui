---
/**
 * @component HamburgerMenu
 * @title Hamburger Menu
 * @description A compact mobile navigation bar with simple links or expandable groups.
 * @figmaUrl https://www.figma.com/design/koxai7zw5vIuBzuVxe5T2l/bejamas-ui?node-id=5940-5284
 *
 * @preview
 * <div class="relative w-full max-w-[375px] self-start overflow-hidden border border-border [--hamburger-menu-panel-height:272px] [&:has([data-state=open])]:h-[320px]">
 * <HamburgerMenu>
 *   <HamburgerMenuBar>
 *     <span class="flex h-8 w-[100px] items-center justify-center rounded-lg bg-muted text-muted-foreground">Slot area</span>
 *     <Button as="a" href="https://github.com/bejamas" variant="secondary" size="sm" aria-label="Bejamas on GitHub, 220 stars"><img class="dark:brightness-0 dark:invert" src="/figma/hamburger-menu/github-header.svg" width="14" height="14" alt="" />220</Button>
 *   </HamburgerMenuBar>
 *   <HamburgerMenuPanel>
 *     <HamburgerMenuLink href="#getting-started">Getting started</HamburgerMenuLink>
 *     <HamburgerMenuLink href="#components">Components</HamburgerMenuLink>
 *   </HamburgerMenuPanel>
 * </HamburgerMenu>
 * </div>
 *
 * @usage
 * ```astro nocollapse
 * ---
 * import { HamburgerMenu, HamburgerMenuBar, HamburgerMenuPanel, HamburgerMenuLink, HamburgerMenuGroup, HamburgerMenuSection } from '@bejamas/ui/components/hamburger-menu';
 * ---
 * <HamburgerMenu>
 *   <HamburgerMenuBar class="px-5" triggerClass="rounded-full bg-muted">
 *     <a href="/">Bejamas UI</a>
 *     <span slot="trigger-open" class="text-xs font-semibold">Menu</span>
 *     <span slot="trigger-close" class="text-xs font-semibold">Close</span>
 *   </HamburgerMenuBar>
 *   <HamburgerMenuPanel label="Main navigation" class="px-5">
 *     <p slot="header" class="mb-4 text-sm text-muted-foreground">Explore the site</p>
 *     <HamburgerMenuGroup label="Getting started" defaultOpen>
 *       <HamburgerMenuLink href="/introduction">Introduction</HamburgerMenuLink>
 *       <HamburgerMenuLink href="/installation">Installation</HamburgerMenuLink>
 *     </HamburgerMenuGroup>
 *     <HamburgerMenuSection label="Company">
 *       <HamburgerMenuLink href="/about">About us</HamburgerMenuLink>
 *     </HamburgerMenuSection>
 *   </HamburgerMenuPanel>
 * </HamburgerMenu>
 * ```
 *
 * @api
 *
 * Place `HamburgerMenuBar` and `HamburgerMenuPanel` directly inside `HamburgerMenu`. The bar owns the trigger button and the panel owns the navigation landmark. Put `defaultOpen`, `openLabel`, `closeLabel`, and `triggerClass` on the bar; put the navigation `label` and panel styles on the panel. The panel accepts `header` and `footer` slots plus `headerClass`, `itemsClass`, and `footerClass`. The root manages Escape, outside clicks, and focus behavior. For a fixed-height preview, set `--hamburger-menu-panel-height` on a parent element.
 *
 * The trigger supports mouse, touch, Enter, and Space. Escape closes an open panel, even after focus leaves it, and restores focus to the trigger when focus was inside the menu. Selecting a link closes the panel. Set `closeOnFocusOutside` to close the panel when keyboard focus leaves the menu; it defaults to `false`. Set `closeOnOutsideClick={false}` for previews that should stay open while navigating the page. Use `HamburgerMenuLink` for direct links, `HamburgerMenuGroup` for expandable sections, and `HamburgerMenuSection` for labelled sections that stay visible. The existing `MenuItem`, `MenuGroup`, and `MenuSection` names remain available. Groups use native disclosure elements and support keyboard interaction.
 *
 * @examples
 *
 * ### Closed
 *
 * <HamburgerMenu>
 *   <HamburgerMenuBar><a href="/">Bejamas UI</a></HamburgerMenuBar>
 *   <HamburgerMenuPanel><HamburgerMenuLink href="#docs">Docs</HamburgerMenuLink></HamburgerMenuPanel>
 * </HamburgerMenu>
 *
 * ### Opened With Links
 *
 * <HamburgerMenu closeOnOutsideClick={false}>
 *   <HamburgerMenuBar defaultOpen><a href="/">Bejamas UI</a></HamburgerMenuBar>
 *   <HamburgerMenuPanel><HamburgerMenuLink href="#docs">Docs</HamburgerMenuLink></HamburgerMenuPanel>
 * </HamburgerMenu>
 *
 * ### Opened With Groups
 *
 * <HamburgerMenu closeOnOutsideClick={false}>
 *   <HamburgerMenuBar defaultOpen><a href="/">Bejamas UI</a></HamburgerMenuBar>
 *   <HamburgerMenuPanel>
 *     <HamburgerMenuGroup label="Resources" defaultOpen>
 *       <HamburgerMenuLink href="#docs">Docs</HamburgerMenuLink>
 *     </HamburgerMenuGroup>
 *   </HamburgerMenuPanel>
 * </HamburgerMenu>
 */
import { cn } from "@bejamas/registry/lib/utils";
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"div"> {
  class?: string;
  closeOnOutsideClick?: boolean;
  /** Close the panel when keyboard focus leaves the menu. */
  closeOnFocusOutside?: boolean;
}

const {
  class: className = "",
  closeOnOutsideClick = true,
  closeOnFocusOutside = false,
  id = `hamburger-menu-${crypto.randomUUID()}`,
  ...rest
} = Astro.props as Props;
---

<div
  {...rest}
  id={id}
  data-slot="hamburger-menu"
  data-close-on-outside-click={closeOnOutsideClick ? undefined : "false"}
  data-close-on-focus-outside={closeOnFocusOutside ? "true" : undefined}
  class={cn(
    "cn-hamburger-menu group/hamburger-menu relative w-full bg-background text-foreground",
    className,
  )}
>
  <slot />
</div>

<style is:global>
  [data-slot="hamburger-menu"]:has(
      > [data-slot="hamburger-menu-bar"] [aria-expanded="false"]
    )
    > [data-slot="hamburger-menu-panel"] {
    display: none;
  }
</style>

<script>
  let lastInteractedMenu: HTMLElement | null = null;

  function initializeHamburgerMenu(root: HTMLElement) {
    if (root.dataset.initialized === "true") return;
    root.dataset.initialized = "true";
    const trigger = root.querySelector<HTMLButtonElement>(
      '[data-slot="hamburger-menu-trigger"]',
    );
    const panel = root.querySelector<HTMLElement>(
      '[data-slot="hamburger-menu-panel"]',
    );
    const openIcon = root.querySelector<HTMLElement>(
      '[data-slot="hamburger-menu-icon-open"]',
    );
    const closeIcon = root.querySelector<HTMLElement>(
      '[data-slot="hamburger-menu-icon-close"]',
    );
    if (!trigger || !panel) return;
    trigger.setAttribute("aria-controls", panel.id);
    const bar = trigger.closest<HTMLElement>(
      '[data-slot="hamburger-menu-bar"]',
    );
    const controller = new AbortController();
    const { signal } = controller;

    const setOpen = (open: boolean, restoreFocus = false) => {
      if (open) lastInteractedMenu = root;
      root.dataset.state = open ? "open" : "closed";
      if (bar) bar.dataset.state = open ? "open" : "closed";
      panel.hidden = !open;
      panel.classList.toggle("hidden", !open);
      trigger.setAttribute("aria-expanded", String(open));
      trigger.setAttribute(
        "aria-label",
        open
          ? (bar?.dataset.closeLabel ?? "Close menu")
          : (bar?.dataset.openLabel ?? "Open menu"),
      );
      openIcon?.classList.toggle("hidden", open);
      closeIcon?.classList.toggle("hidden", !open);
      if (restoreFocus) trigger.focus();
    };

    setOpen(trigger.getAttribute("aria-expanded") === "true");

    trigger.addEventListener("click", () => setOpen(panel.hidden === true), {
      signal,
    });
    root.addEventListener(
      "focusin",
      () => {
        lastInteractedMenu = root;
      },
      {
        signal,
      },
    );
    root.addEventListener(
      "pointerdown",
      () => {
        lastInteractedMenu = root;
      },
      {
        signal,
      },
    );
    root.addEventListener(
      "focusout",
      (event) => {
        if (
          !panel.hidden &&
          root.dataset.closeOnFocusOutside === "true" &&
          !(
            event.relatedTarget instanceof Node &&
            root.contains(event.relatedTarget)
          )
        )
          setOpen(false);
      },
      { signal },
    );
    document.addEventListener(
      "keydown",
      (event) => {
        if (event.key !== "Escape" || event.defaultPrevented || panel.hidden)
          return;
        const focusedMenu = document.activeElement?.closest<HTMLElement>(
          '[data-slot="hamburger-menu"][data-state="open"]',
        );
        const openMenu = document.querySelector<HTMLElement>(
          '[data-slot="hamburger-menu"][data-state="open"]',
        );
        const targetMenu =
          focusedMenu ??
          (lastInteractedMenu?.dataset.state === "open"
            ? lastInteractedMenu
            : openMenu);
        if (targetMenu !== root) return;
        event.preventDefault();
        setOpen(false, root.contains(document.activeElement));
      },
      { signal },
    );
    document.addEventListener(
      "pointerdown",
      (event) => {
        if (
          !panel.hidden &&
          root.dataset.closeOnOutsideClick !== "false" &&
          event.target instanceof Node &&
          !root.contains(event.target)
        ) {
          setOpen(false);
        }
      },
      { signal },
    );
    panel.addEventListener(
      "click",
      (event) => {
        const target = event.target;
        if (target instanceof Element && target.closest("a[href]"))
          setOpen(false);
      },
      { signal },
    );
    document.addEventListener("astro:before-swap", () => controller.abort(), {
      once: true,
      signal,
    });
  }

  document
    .querySelectorAll<HTMLElement>('[data-slot="hamburger-menu"]')
    .forEach(initializeHamburgerMenu);
  document.addEventListener("astro:page-load", () => {
    document
      .querySelectorAll<HTMLElement>('[data-slot="hamburger-menu"]')
      .forEach(initializeHamburgerMenu);
  });
</script>
