---
/**
 * @component HamburgerMenu
 * @title Hamburger Menu
 * @description A compact mobile navigation bar with simple links or expandable groups.
 * @figmaUrl https://www.figma.com/design/koxai7zw5vIuBzuVxe5T2l/bejamas-ui?node-id=5940-5284
 * @dataSlotUrl https://data-slot.com/components/collapsible
 *
 * @preview
 * <div class="relative w-full max-w-[375px] self-start overflow-hidden border border-border [--hamburger-menu-panel-height:272px] [&:has([data-state=open])]:h-[320px]">
 *   <HamburgerMenu closeOnOutsideClick={false}>
 *     <span slot="brand" class="flex h-8 w-[100px] items-center justify-center rounded-lg bg-muted text-muted-foreground">Slot area</span>
 *     <Button slot="actions" type="button" variant="secondary" size="icon" aria-label="Toggle theme"><SemanticIcon name="sun" /></Button>
 *     <Button slot="actions" as="a" href="https://github.com/bejamas" variant="secondary" aria-label="Bejamas on GitHub, 220 stars"><img class="dark:brightness-0 dark:invert" src="/figma/hamburger-menu/github-header.svg" width="14" height="14" alt="" />220</Button>
 *     <HamburgerMenuItem href="#getting-started">Getting started</HamburgerMenuItem>
 *     <HamburgerMenuItem href="#components">Components</HamburgerMenuItem>
 *   </HamburgerMenu>
 * </div>
 *
 * @usage
 * ```astro nocollapse
 * ---
 * import { HamburgerMenu, HamburgerMenuItem, HamburgerMenuGroup } from '@bejamas/ui/components/hamburger-menu';
 * ---
 * <HamburgerMenu>
 *   <a slot="brand" href="/">Bejamas UI</a>
 *   <HamburgerMenuGroup label="Getting started" defaultOpen>
 *     <HamburgerMenuItem href="/introduction">Introduction</HamburgerMenuItem>
 *     <HamburgerMenuItem href="/installation">Installation</HamburgerMenuItem>
 *   </HamburgerMenuGroup>
 * </HamburgerMenu>
 * ```
 *
 * @api
 *
 * The 48px header remains visible while the panel fills the rest of the viewport. Add your own controls with the `brand`, `actions`, and `footer` slots. For a fixed-height preview, set `--hamburger-menu-panel-height` on a parent element.
 *
 * Adapt the layout to an existing site header:
 *
 * - `triggerPosition="start"` places the trigger before the brand. It stays first in the tab order.
 * - `panel="inline"` renders the panel in the page flow, so opening it pushes the content below down instead of covering the viewport.
 * - `--hamburger-menu-bar-height` sets the bar height, and the overlay panel fills the viewport below it.
 * - `barClass`, `triggerClass`, and `panelClass` restyle the bar, the trigger, and the panel.
 * - The `trigger` slot replaces the menu and close icons. Use `group-data-[state=open]/hamburger-menu:` classes to swap icons when the menu opens.
 *
 * For a side sheet, use Drawer instead.
 *
 * The trigger is named by `triggerLabel` and reports its state with `aria-expanded`. It supports mouse, touch, Enter, and Space. Escape closes the panel and returns focus to the trigger when focus was inside the menu. Clicking outside the menu or selecting a link closes the panel. Popovers and menus opened from the menu close first and count as inside it. Set `closeOnOutsideClick={false}` to keep the panel open while interacting with the rest of the page, for example in previews. Groups use native disclosure elements and support keyboard interaction.
 *
 * The open state and dismissal are managed by `@data-slot/collapsible`, so the root sets `data-state` (`open` or `closed`), emits `collapsible:change` with `{ open: boolean }`, and accepts `collapsible:set` with `{ open: boolean }` for programmatic control.
 *
 * @examples
 *
 * ### Closed
 *
 * <div class="relative w-full max-w-[375px] self-start overflow-hidden border border-border [--hamburger-menu-panel-height:688px] [&:has([data-state=open])]:h-[736px]">
 *   <HamburgerMenu closeOnOutsideClick={false}>
 *     <span slot="brand" class="flex h-8 w-[100px] items-center justify-center rounded-lg bg-muted text-muted-foreground">Slot area</span>
 *     <Button slot="actions" type="button" variant="secondary" size="icon" aria-label="Toggle theme"><SemanticIcon name="sun" /></Button>
 *     <Button slot="actions" as="a" href="https://github.com/bejamas" variant="secondary" aria-label="Bejamas on GitHub, 220 stars"><img class="dark:brightness-0 dark:invert" src="/figma/hamburger-menu/github-header.svg" width="14" height="14" alt="" />220</Button>
 *     <HamburgerMenuItem href="#getting-started">Getting started</HamburgerMenuItem>
 *   </HamburgerMenu>
 * </div>
 *
 * ### Opened Simple
 *
 * <div class="relative w-full max-w-[375px] self-start overflow-hidden border border-border [--hamburger-menu-panel-height:688px] [&:has([data-state=open])]:h-[736px]">
 *   <HamburgerMenu defaultOpen closeOnOutsideClick={false}>
 *     <span slot="brand" class="flex h-8 w-[100px] items-center justify-center rounded-lg bg-muted text-muted-foreground">Slot area</span>
 *     <Button slot="actions" type="button" variant="secondary" size="icon" aria-label="Toggle theme"><SemanticIcon name="sun" /></Button>
 *     <Button slot="actions" as="a" href="https://github.com/bejamas" variant="secondary" aria-label="Bejamas on GitHub, 220 stars"><img class="dark:brightness-0 dark:invert" src="/figma/hamburger-menu/github-header.svg" width="14" height="14" alt="" />220</Button>
 *     <HamburgerMenuItem href="#getting-started">Getting started</HamburgerMenuItem>
 *     <HamburgerMenuItem href="#installation">Installation</HamburgerMenuItem>
 *     <HamburgerMenuItem href="#components">Components</HamburgerMenuItem>
 *     <HamburgerMenuItem href="#concepts">Concepts</HamburgerMenuItem>
 *     <HamburgerMenuItem href="#blog">Blog</HamburgerMenuItem>
 *     <HamburgerMenuItem href="#about">About us</HamburgerMenuItem>
 *     <HamburgerMenuItem href="#contact">Contact us</HamburgerMenuItem>
 *     <HamburgerMenuItem href="#faq">FAQ</HamburgerMenuItem>
 *     <Button slot="footer" as="a" href="https://x.com/bejamas" variant="secondary" size="icon" aria-label="Bejamas on X"><img class="dark:brightness-0 dark:invert" src="/figma/hamburger-menu/social-x.svg" width="16" height="16" alt="" /></Button>
 *     <Button slot="footer" as="a" href="https://github.com/bejamas" variant="secondary" size="icon" aria-label="Bejamas on GitHub"><img class="dark:brightness-0 dark:invert" src="/figma/hamburger-menu/github-footer.svg" width="16" height="16" alt="" /></Button>
 *   </HamburgerMenu>
 * </div>
 *
 * ### Opened Advanced
 *
 * <div class="relative w-full max-w-[375px] self-start overflow-hidden border border-border [--hamburger-menu-panel-height:688px] [&:has([data-state=open])]:h-[736px]">
 *   <HamburgerMenu defaultOpen closeOnOutsideClick={false}>
 *     <span slot="brand" class="flex h-8 w-[100px] items-center justify-center rounded-lg bg-muted text-muted-foreground">Slot area</span>
 *     <Button slot="actions" type="button" variant="secondary" size="icon" aria-label="Toggle theme"><SemanticIcon name="sun" /></Button>
 *     <Button slot="actions" as="a" href="https://github.com/bejamas" variant="secondary" aria-label="Bejamas on GitHub, 220 stars"><img class="dark:brightness-0 dark:invert" src="/figma/hamburger-menu/github-header.svg" width="14" height="14" alt="" />220</Button>
 *     <HamburgerMenuGroup label="Getting started" defaultOpen>
 *       <HamburgerMenuItem href="#introduction">Introduction</HamburgerMenuItem>
 *       <HamburgerMenuItem href="#installation-advanced">Installation</HamburgerMenuItem>
 *       <HamburgerMenuItem href="#cli">CLI</HamburgerMenuItem>
 *       <HamburgerMenuItem href="#forms">Forms with Astro Actions</HamburgerMenuItem>
 *     </HamburgerMenuGroup>
 *     <HamburgerMenuGroup label="Components"><HamburgerMenuItem href="#buttons">Buttons</HamburgerMenuItem></HamburgerMenuGroup>
 *     <HamburgerMenuGroup label="Concepts"><HamburgerMenuItem href="#theming">Theming</HamburgerMenuItem></HamburgerMenuGroup>
 *     <HamburgerMenuGroup label="About us"><HamburgerMenuItem href="#team">Team</HamburgerMenuItem></HamburgerMenuGroup>
 *     <HamburgerMenuGroup label="Contact us"><HamburgerMenuItem href="#contact-details">Contact details</HamburgerMenuItem></HamburgerMenuGroup>
 *     <Button slot="footer" as="a" href="https://x.com/bejamas" variant="secondary" size="icon" aria-label="Bejamas on X"><img class="dark:brightness-0 dark:invert" src="/figma/hamburger-menu/social-x.svg" width="16" height="16" alt="" /></Button>
 *     <Button slot="footer" as="a" href="https://github.com/bejamas" variant="secondary" size="icon" aria-label="Bejamas on GitHub"><img class="dark:brightness-0 dark:invert" src="/figma/hamburger-menu/github-footer.svg" width="16" height="16" alt="" /></Button>
 *   </HamburgerMenu>
 * </div>
 *
 * ### Trigger at start, inline panel
 *
 * <div class="w-full max-w-[375px] self-start overflow-hidden border border-border">
 *   <HamburgerMenu defaultOpen closeOnOutsideClick={false} triggerPosition="start" panel="inline" class="[--hamburger-menu-bar-height:4rem]" barClass="px-4" panelClass="px-4 pb-4">
 *     <span slot="brand" class="flex h-8 w-[100px] items-center justify-center rounded-lg bg-muted text-muted-foreground">Slot area</span>
 *     <Button slot="actions" size="sm">Sign up</Button>
 *     <HamburgerMenuItem href="#features">Features</HamburgerMenuItem>
 *     <HamburgerMenuItem href="#pricing">Pricing</HamburgerMenuItem>
 *     <HamburgerMenuItem href="#blog-inline">Blog</HamburgerMenuItem>
 *   </HamburgerMenu>
 *   <p class="p-4 text-sm text-muted-foreground">The page content moves down while the menu is open.</p>
 * </div>
 */
import { cn } from "@bejamas/registry/lib/utils";
import SemanticIcon from "../icon/SemanticIcon.astro";
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"div"> {
  class?: string;
  defaultOpen?: boolean;
  /** Close the panel on a pointer press outside the menu. */
  closeOnOutsideClick?: boolean;
  /** Accessible name of the navigation region. */
  label?: string;
  /** Accessible name of the menu trigger. */
  triggerLabel?: string;
  /** Place the trigger before the brand (`start`) or after the actions (`end`). */
  triggerPosition?: "start" | "end";
  /** Cover the page below the bar (`overlay`) or push it down (`inline`). */
  panel?: "overlay" | "inline";
  barClass?: string;
  triggerClass?: string;
  panelClass?: string;
}

const {
  class: className = "",
  defaultOpen = false,
  closeOnOutsideClick = true,
  label = "Mobile navigation",
  triggerLabel = "Menu",
  triggerPosition = "end",
  panel = "overlay",
  barClass,
  triggerClass,
  panelClass,
  id = `hamburger-menu-${crypto.randomUUID()}`,
  ...rest
} = Astro.props as Props;
const panelId = `${id}-panel`;
const triggerAttributes = {
  class: cn(
    "inline-flex size-8 shrink-0 items-center justify-center rounded-lg text-foreground outline-none hover:bg-muted focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:ring-offset-background",
    triggerClass,
  ),
  "aria-label": triggerLabel,
  "aria-controls": panelId,
  "aria-expanded": defaultOpen ? "true" : "false",
} as const;
---

<div
  {...rest}
  id={id}
  data-slot="hamburger-menu"
  data-state={defaultOpen ? "open" : "closed"}
  data-panel={panel}
  data-default-open={defaultOpen ? true : undefined}
  data-close-on-escape
  data-close-on-click-outside={closeOnOutsideClick ? true : undefined}
  class={cn(
    "cn-hamburger-menu group/hamburger-menu relative w-full bg-background text-foreground",
    className,
  )}
>
  <div
    data-slot="hamburger-menu-bar"
    class={cn(
      "flex h-[var(--hamburger-menu-bar-height,3rem)] items-center gap-3 border-b border-border px-3 py-2",
      barClass,
    )}
  >
    {triggerPosition === "start" && (
      <button type="button" data-slot="collapsible-trigger" {...triggerAttributes}>
        <slot name="trigger">
          <SemanticIcon
            name="menu"
            class="size-4 group-data-[state=open]/hamburger-menu:hidden"
          />
          <SemanticIcon
            name="x"
            class="hidden size-4 group-data-[state=open]/hamburger-menu:block"
          />
        </slot>
      </button>
    )}
    <div data-slot="hamburger-menu-brand" class="me-auto min-w-0 shrink-0">
      <slot name="brand" />
    </div>
    {Astro.slots.has("actions") && (
      <div data-slot="hamburger-menu-actions" class="flex min-w-0 items-center gap-3">
        <slot name="actions" />
      </div>
    )}
    {triggerPosition === "end" && (
      <button type="button" data-slot="collapsible-trigger" {...triggerAttributes}>
        <slot name="trigger">
          <SemanticIcon
            name="menu"
            class="size-4 group-data-[state=open]/hamburger-menu:hidden"
          />
          <SemanticIcon
            name="x"
            class="hidden size-4 group-data-[state=open]/hamburger-menu:block"
          />
        </slot>
      </button>
    )}
  </div>
  <div
    id={panelId}
    data-slot="collapsible-content"
    hidden={!defaultOpen}
    class={cn(
      "bg-background px-3 pt-3 pb-6",
      panel === "inline"
        ? "border-b border-border"
        : "absolute inset-x-0 top-full z-50 h-[var(--hamburger-menu-panel-height,calc(100dvh_-_var(--hamburger-menu-bar-height,3rem)))] overflow-y-auto overscroll-contain shadow-sm",
      panelClass,
    )}
  >
    <nav
      aria-label={label}
      class="flex min-h-full flex-col justify-between"
    >
      <div
        data-slot="hamburger-menu-items"
        class="flex flex-col gap-2"
      >
        <slot />
      </div>
      {Astro.slots.has("footer") && (
        <div
          data-slot="hamburger-menu-footer"
          class="mt-8 flex items-center gap-1.5"
        >
          <slot name="footer" />
        </div>
      )}
    </nav>
  </div>
</div>

<script>
  import { createCollapsible } from "@data-slot/collapsible";

  const menus = new Map<HTMLElement, () => void>();

  function initializeHamburgerMenus() {
    document
      .querySelectorAll<HTMLElement>('[data-slot="hamburger-menu"]')
      .forEach((root) => {
        if (menus.has(root)) return;
        const collapsible = createCollapsible(root);
        // Selecting a link navigates, so close the panel.
        const closeOnLinkClick = (event: Event) => {
          const target = event.target;
          if (target instanceof Element && target.closest("a[href]"))
            collapsible.close();
        };
        root.addEventListener("click", closeOnLinkClick);
        menus.set(root, () => {
          root.removeEventListener("click", closeOnLinkClick);
          collapsible.destroy();
        });
      });
  }

  initializeHamburgerMenus();
  document.addEventListener("astro:page-load", initializeHamburgerMenus);
  document.addEventListener("astro:before-swap", () => {
    menus.forEach((destroy) => destroy());
    menus.clear();
  });
</script>
