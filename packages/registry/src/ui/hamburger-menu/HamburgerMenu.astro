---
/**
 * @component HamburgerMenu
 * @title Hamburger Menu
 * @description A compact mobile navigation bar with simple links or expandable groups.
 * @figmaUrl https://www.figma.com/design/koxai7zw5vIuBzuVxe5T2l/bejamas-ui?node-id=5940-5284
 *
 * @preview
 * <div class="relative w-full max-w-[375px] self-start overflow-hidden border border-border [--hamburger-menu-panel-height:272px] [&:has([data-state=open])]:h-[320px]">
 *   <HamburgerMenu closeOnOutsideClick={false}>
 *     <span slot="brand" class="flex h-8 w-[100px] items-center justify-center rounded-lg bg-muted text-muted-foreground">Slot area</span>
 *     <Button slot="actions" type="button" variant="secondary" size="icon" aria-label="Toggle theme"><SemanticIcon name="sun" /></Button>
 *     <Button slot="actions" as="a" href="https://github.com/bejamas" variant="secondary" aria-label="Bejamas on GitHub, 220 stars"><img class="dark:brightness-0 dark:invert" src="/figma/hamburger-menu/github-header.svg" width="14" height="14" alt="" />220</Button>
 *     <MenuItem href="#getting-started">Getting started</MenuItem>
 *     <MenuItem href="#components">Components</MenuItem>
 *   </HamburgerMenu>
 * </div>
 *
 * @usage
 * ```astro nocollapse
 * ---
 * import { HamburgerMenu, MenuItem, MenuGroup } from '@bejamas/ui/components/hamburger-menu';
 * ---
 * <HamburgerMenu>
 *   <a slot="brand" href="/">Bejamas UI</a>
 *   <MenuGroup label="Getting started" defaultOpen>
 *     <MenuItem href="/introduction">Introduction</MenuItem>
 *     <MenuItem href="/installation">Installation</MenuItem>
 *   </MenuGroup>
 * </HamburgerMenu>
 * ```
 *
 * @api
 *
 * The 48px header remains visible while the panel fills the rest of the viewport. Add your own controls with the `brand`, `actions`, and `footer` slots. For a fixed-height preview, set `--hamburger-menu-panel-height` on a parent element.
 *
 * The trigger supports mouse, touch, Enter, and Space. Escape closes the panel and returns focus to the trigger when focus was inside the menu. Clicking outside the menu or selecting a link closes the panel. Popovers and menus opened from the menu close first and count as inside it. Set `closeOnOutsideClick={false}` to keep the panel open while interacting with the rest of the page, for example in previews. Groups use native disclosure elements and support keyboard interaction.
 *
 * The open state and dismissal are managed by `@data-slot/collapsible`, so the root sets `data-state` (`open` or `closed`), emits `collapsible:change` with `{ open: boolean }`, and accepts `collapsible:set` with `{ open: boolean }` for programmatic control.
 *
 * @examples
 *
 * ### Closed
 *
 * <div class="relative w-full max-w-[375px] self-start overflow-hidden border border-border [--hamburger-menu-panel-height:688px] [&:has([data-state=open])]:h-[736px]">
 *   <HamburgerMenu closeOnOutsideClick={false}>
 *     <span slot="brand" class="flex h-8 w-[100px] items-center justify-center rounded-lg bg-muted text-muted-foreground">Slot area</span>
 *     <Button slot="actions" type="button" variant="secondary" size="icon" aria-label="Toggle theme"><SemanticIcon name="sun" /></Button>
 *     <Button slot="actions" as="a" href="https://github.com/bejamas" variant="secondary" aria-label="Bejamas on GitHub, 220 stars"><img class="dark:brightness-0 dark:invert" src="/figma/hamburger-menu/github-header.svg" width="14" height="14" alt="" />220</Button>
 *     <MenuItem href="#getting-started">Getting started</MenuItem>
 *   </HamburgerMenu>
 * </div>
 *
 * ### Opened Simple
 *
 * <div class="relative w-full max-w-[375px] self-start overflow-hidden border border-border [--hamburger-menu-panel-height:688px] [&:has([data-state=open])]:h-[736px]">
 *   <HamburgerMenu defaultOpen closeOnOutsideClick={false}>
 *     <span slot="brand" class="flex h-8 w-[100px] items-center justify-center rounded-lg bg-muted text-muted-foreground">Slot area</span>
 *     <Button slot="actions" type="button" variant="secondary" size="icon" aria-label="Toggle theme"><SemanticIcon name="sun" /></Button>
 *     <Button slot="actions" as="a" href="https://github.com/bejamas" variant="secondary" aria-label="Bejamas on GitHub, 220 stars"><img class="dark:brightness-0 dark:invert" src="/figma/hamburger-menu/github-header.svg" width="14" height="14" alt="" />220</Button>
 *     <MenuItem href="#getting-started">Getting started</MenuItem>
 *     <MenuItem href="#installation">Installation</MenuItem>
 *     <MenuItem href="#components">Components</MenuItem>
 *     <MenuItem href="#concepts">Concepts</MenuItem>
 *     <MenuItem href="#blog">Blog</MenuItem>
 *     <MenuItem href="#about">About us</MenuItem>
 *     <MenuItem href="#contact">Contact us</MenuItem>
 *     <MenuItem href="#faq">FAQ</MenuItem>
 *     <Button slot="footer" as="a" href="https://x.com/bejamas" variant="secondary" size="icon" aria-label="Bejamas on X"><img class="dark:brightness-0 dark:invert" src="/figma/hamburger-menu/social-x.svg" width="16" height="16" alt="" /></Button>
 *     <Button slot="footer" as="a" href="https://github.com/bejamas" variant="secondary" size="icon" aria-label="Bejamas on GitHub"><img class="dark:brightness-0 dark:invert" src="/figma/hamburger-menu/github-footer.svg" width="16" height="16" alt="" /></Button>
 *   </HamburgerMenu>
 * </div>
 *
 * ### Opened Advanced
 *
 * <div class="relative w-full max-w-[375px] self-start overflow-hidden border border-border [--hamburger-menu-panel-height:688px] [&:has([data-state=open])]:h-[736px]">
 *   <HamburgerMenu defaultOpen closeOnOutsideClick={false}>
 *     <span slot="brand" class="flex h-8 w-[100px] items-center justify-center rounded-lg bg-muted text-muted-foreground">Slot area</span>
 *     <Button slot="actions" type="button" variant="secondary" size="icon" aria-label="Toggle theme"><SemanticIcon name="sun" /></Button>
 *     <Button slot="actions" as="a" href="https://github.com/bejamas" variant="secondary" aria-label="Bejamas on GitHub, 220 stars"><img class="dark:brightness-0 dark:invert" src="/figma/hamburger-menu/github-header.svg" width="14" height="14" alt="" />220</Button>
 *     <MenuGroup label="Getting started" defaultOpen>
 *       <MenuItem href="#introduction">Introduction</MenuItem>
 *       <MenuItem href="#installation-advanced">Installation</MenuItem>
 *       <MenuItem href="#cli">CLI</MenuItem>
 *       <MenuItem href="#forms">Forms with Astro Actions</MenuItem>
 *     </MenuGroup>
 *     <MenuGroup label="Components"><MenuItem href="#buttons">Buttons</MenuItem></MenuGroup>
 *     <MenuGroup label="Concepts"><MenuItem href="#theming">Theming</MenuItem></MenuGroup>
 *     <MenuGroup label="About us"><MenuItem href="#team">Team</MenuItem></MenuGroup>
 *     <MenuGroup label="Contact us"><MenuItem href="#contact-details">Contact details</MenuItem></MenuGroup>
 *     <Button slot="footer" as="a" href="https://x.com/bejamas" variant="secondary" size="icon" aria-label="Bejamas on X"><img class="dark:brightness-0 dark:invert" src="/figma/hamburger-menu/social-x.svg" width="16" height="16" alt="" /></Button>
 *     <Button slot="footer" as="a" href="https://github.com/bejamas" variant="secondary" size="icon" aria-label="Bejamas on GitHub"><img class="dark:brightness-0 dark:invert" src="/figma/hamburger-menu/github-footer.svg" width="16" height="16" alt="" /></Button>
 *   </HamburgerMenu>
 * </div>
 */
import { cn } from "@bejamas/registry/lib/utils";
import SemanticIcon from "../icon/SemanticIcon.astro";
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"div"> {
  class?: string;
  defaultOpen?: boolean;
  /** Close the panel on a pointer press outside the menu. */
  closeOnOutsideClick?: boolean;
  /** Accessible name of the navigation region. */
  label?: string;
}

const {
  class: className = "",
  defaultOpen = false,
  closeOnOutsideClick = true,
  label = "Mobile navigation",
  id = `hamburger-menu-${crypto.randomUUID()}`,
  ...rest
} = Astro.props as Props;
const panelId = `${id}-panel`;
---

<div
  {...rest}
  id={id}
  data-slot="hamburger-menu"
  data-state={defaultOpen ? "open" : "closed"}
  data-default-open={defaultOpen ? true : undefined}
  data-close-on-escape
  data-close-on-click-outside={closeOnOutsideClick ? true : undefined}
  class={cn(
    "cn-hamburger-menu group/hamburger-menu relative w-full bg-background text-foreground",
    className,
  )}
>
  <div
    data-slot="hamburger-menu-bar"
    class="flex h-12 items-center justify-between gap-3 border-b border-border px-3 py-2"
  >
    <div data-slot="hamburger-menu-brand" class="min-w-0 shrink-0">
      <slot name="brand" />
    </div>
    <div class="flex min-w-0 items-center gap-3">
      <div data-slot="hamburger-menu-actions" class="flex items-center gap-3">
        <slot name="actions" />
      </div>
      <button
        type="button"
        data-slot="collapsible-trigger"
        class="inline-flex size-8 shrink-0 items-center justify-center rounded-lg text-foreground outline-none hover:bg-muted focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:ring-offset-background"
        aria-label={defaultOpen ? "Close menu" : "Open menu"}
        aria-controls={panelId}
        aria-expanded={defaultOpen ? "true" : "false"}
      >
        <SemanticIcon
          name="menu"
          class="size-4 group-data-[state=open]/hamburger-menu:hidden"
        />
        <SemanticIcon
          name="x"
          class="hidden size-4 group-data-[state=open]/hamburger-menu:block"
        />
      </button>
    </div>
  </div>
  <nav
    id={panelId}
    data-slot="collapsible-content"
    aria-label={label}
    hidden={!defaultOpen}
    class={cn(
      "absolute inset-x-0 top-full z-50 flex h-[var(--hamburger-menu-panel-height,calc(100dvh-3rem))] flex-col justify-between overflow-y-auto overscroll-contain bg-background px-3 pt-3 pb-6 shadow-sm",
    )}
  >
    <div
      data-slot="hamburger-menu-items"
      class="flex flex-col gap-2"
    >
      <slot />
    </div>
    {Astro.slots.has("footer") && (
      <div
        data-slot="hamburger-menu-footer"
        class="mt-8 flex items-center gap-1.5"
      >
        <slot name="footer" />
      </div>
    )}
  </nav>
</div>

<script>
  import { createCollapsible } from "@data-slot/collapsible";

  const menus = new Map<HTMLElement, () => void>();

  function initializeHamburgerMenus() {
    document
      .querySelectorAll<HTMLElement>('[data-slot="hamburger-menu"]')
      .forEach((root) => {
        if (menus.has(root)) return;
        const collapsible = createCollapsible(root);
        const trigger = root.querySelector<HTMLButtonElement>(
          '[data-slot="collapsible-trigger"]',
        )!;
        const panel = root.querySelector<HTMLElement>(
          '[data-slot="collapsible-content"]',
        )!;
        // Collapsible turns its content into a region labelled by the trigger;
        // keep the panel a navigation landmark named by `label`.
        panel.removeAttribute("role");
        panel.removeAttribute("aria-labelledby");
        const controller = new AbortController();
        const { signal } = controller;

        root.addEventListener(
          "collapsible:change",
          () => {
            trigger.setAttribute(
              "aria-label",
              collapsible.isOpen ? "Close menu" : "Open menu",
            );
          },
          { signal },
        );
        panel.addEventListener(
          "click",
          (event) => {
            const target = event.target;
            if (target instanceof Element && target.closest("a[href]"))
              collapsible.close();
          },
          { signal },
        );
        menus.set(root, () => {
          controller.abort();
          collapsible.destroy();
        });
      });
  }

  initializeHamburgerMenus();
  document.addEventListener("astro:page-load", initializeHamburgerMenus);
  document.addEventListener("astro:before-swap", () => {
    menus.forEach((destroy) => destroy());
    menus.clear();
  });
</script>
