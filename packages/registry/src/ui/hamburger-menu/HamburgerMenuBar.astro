---
import { cn } from "@bejamas/registry/lib/utils";
import SemanticIcon from "../icon/SemanticIcon.astro";
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"div"> {
  class?: string;
  triggerClass?: string;
  defaultOpen?: boolean;
  openLabel?: string;
  closeLabel?: string;
}

const {
  class: className = "",
  triggerClass = "",
  defaultOpen = false,
  openLabel = "Open menu",
  closeLabel = "Close menu",
  ...rest
} = Astro.props as Props;
---

<div
  {...rest}
  data-slot="hamburger-menu-bar"
  data-state={defaultOpen ? "open" : "closed"}
  data-open-label={openLabel}
  data-close-label={closeLabel}
  class={cn(
    "flex h-12 items-center justify-between gap-3 border-b border-border px-3 py-2",
    className,
  )}
>
  <div class="flex min-w-0 flex-1 items-center justify-between gap-3">
    <slot />
  </div>
  <button
    type="button"
    data-slot="hamburger-menu-trigger"
    class={cn(
      "inline-flex size-8 shrink-0 items-center justify-center rounded-lg text-foreground outline-none hover:bg-muted focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:ring-offset-background",
      triggerClass,
    )}
    aria-label={defaultOpen ? closeLabel : openLabel}
    aria-expanded={defaultOpen ? "true" : "false"}
  >
    <span
      data-slot="hamburger-menu-icon-open"
      aria-hidden="true"
      class={defaultOpen ? "hidden" : undefined}
    >
      <slot name="trigger-open">
        <SemanticIcon name="menu" class="size-4" />
      </slot>
    </span>
    <span
      data-slot="hamburger-menu-icon-close"
      aria-hidden="true"
      class={!defaultOpen ? "hidden" : undefined}
    >
      <slot name="trigger-close">
        <SemanticIcon name="x" class="size-4" />
      </slot>
    </span>
  </button>
</div>
