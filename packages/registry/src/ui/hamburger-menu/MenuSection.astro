---
import { cn } from "@bejamas/registry/lib/utils";
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"div"> {
  /** Visible heading and accessible name for this non-collapsible section. */
  label: string;
  class?: string;
  headingClass?: string;
  contentClass?: string;
}

const {
  label,
  class: className = "",
  headingClass = "",
  contentClass = "",
  id = `hamburger-menu-section-${crypto.randomUUID()}`,
  ...rest
} = Astro.props as Props;
const headingId = `${id}-heading`;
---

<div
  {...rest}
  id={id}
  data-slot="hamburger-menu-section"
  role="group"
  aria-labelledby={headingId}
  class={cn("flex flex-col gap-2", className)}
>
  <span
    id={headingId}
    data-slot="hamburger-menu-section-heading"
    class={cn(
      "text-xs font-semibold leading-4 text-muted-foreground",
      headingClass,
    )}
  >
    <slot name="heading">{label}</slot>
  </span>
  <div
    data-slot="hamburger-menu-section-content"
    class={cn("flex flex-col gap-2", contentClass)}
  >
    <slot />
  </div>
</div>
