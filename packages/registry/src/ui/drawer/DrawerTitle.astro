---
import { cn } from "@bejamas/registry/lib/utils";
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"h2"> {
  class?: string;
}
const { class: className = "", ...rest } = Astro.props as Props;
---

<h2
  {...rest}
  data-slot="drawer-title"
  class={cn("text-xl leading-6 font-medium text-foreground", className)}
>
  <slot />
</h2>
