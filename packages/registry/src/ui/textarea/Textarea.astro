---
/**
 * @component Textarea
 * @title Textarea
 * @description A multi-line input field for longer user content.
 * @figmaUrl https://www.figma.com/design/koxai7zw5vIuBzuVxe5T2l/bejamas-ui?node-id=2508-2555&t=YFStJ3V8fXEO8QD8-4
 * @status stable
 * @since 0.1.0
 *
 * @preview
 *
 * <Textarea placeholder="Type your message here..." />
 *
 * @usage
 *
 * ```astro nocollapse
 * ---
 * import { Textarea } from '@bejamas/ui/components/textarea';
 * ---
 *
 * <Textarea placeholder="Type your message here..." />
 * ```
 *
 * @examples
 *
 * ### Invalid
 *
 * Set `aria-invalid="true"` to show the error state. Wrap the textarea in a `Field` with a `FieldError` to describe the problem.
 *
 * <Field data-invalid="true" class="w-full max-w-sm">
 *   <FieldLabel for="message-invalid">Message</FieldLabel>
 *   <Textarea
 *     id="message-invalid"
 *     placeholder="Type your message here..."
 *     aria-invalid="true"
 *     aria-describedby="message-invalid-error"
 *   />
 *   <FieldError id="message-invalid-error">Message is required.</FieldError>
 * </Field>
 */

const { class: className = "", ...props } = Astro.props;

const baseClass =
  "flex field-sizing-content min-h-16 w-full outline-none disabled:cursor-not-allowed disabled:opacity-50";

import { cn } from "@bejamas/registry/lib/utils";
---

<textarea
  data-slot={props["data-slot"] ?? "textarea"}
  class={cn("cn-textarea", baseClass, className)}
  {...props}></textarea>
