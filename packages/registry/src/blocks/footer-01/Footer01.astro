---
import { Button } from "@bejamas/registry/ui/button";
import {
  LinkGroup,
  LinkGroupItem,
  LinkGroupList,
  LinkGroupTitle,
} from "@bejamas/registry/ui/link-group";

interface FooterLink {
  label: string;
  href: string;
}

interface FooterColumn {
  title: string;
  links: FooterLink[];
}

interface Props {
  brand?: string;
  tagline?: string;
  ctaTitle?: string;
  ctaLabel?: string;
  ctaHref?: string;
  columns?: FooterColumn[];
  year?: number;
  class?: string;
}

const defaultColumns: FooterColumn[] = [
  {
    title: "Resources",
    links: [
      { label: "Blog", href: "#blog" },
      { label: "Documentation", href: "#docs" },
      { label: "Support", href: "#support" },
    ],
  },
  {
    title: "Company",
    links: [
      { label: "About", href: "#about" },
      { label: "Careers", href: "#careers" },
      { label: "Contact", href: "#contact" },
    ],
  },
  {
    title: "Legal",
    links: [
      { label: "Privacy", href: "#privacy" },
      { label: "Terms", href: "#terms" },
    ],
  },
];

const {
  brand = "Acme",
  tagline = "Thoughtful tools for teams that care about the details.",
  ctaTitle = "Ready to build something clear and useful?",
  ctaLabel = "Get started",
  ctaHref = "#get-started",
  columns = defaultColumns,
  year = new Date().getFullYear(),
  class: className = "",
} = Astro.props as Props;
---

<footer class:list={["w-full border-t bg-muted/30 text-foreground", className]}>
  <div class="mx-auto max-w-6xl px-6">
    <div class="flex flex-col items-center gap-5 border-b py-16 text-center">
      <p
        class="text-sm font-medium uppercase tracking-widest text-muted-foreground"
      >
        Start today
      </p>
      <h2 class="max-w-2xl text-4xl font-medium tracking-tight sm:text-5xl">
        {ctaTitle}
      </h2>
      <Button as="a" href={ctaHref} size="lg">{ctaLabel}</Button>
    </div>

    <div class="grid gap-10 py-12 sm:grid-cols-2 lg:grid-cols-4">
      <div>
        <a href="/" class="text-xl font-semibold tracking-tight">{brand}</a>
        <p class="mt-3 max-w-xs text-sm text-muted-foreground">{tagline}</p>
      </div>
      {
        columns.map((column) => (
          <LinkGroup>
            <LinkGroupTitle>{column.title}</LinkGroupTitle>
            <LinkGroupList>
              {column.links.map((link) => (
                <LinkGroupItem>
                  <a href={link.href}>{link.label}</a>
                </LinkGroupItem>
              ))}
            </LinkGroupList>
          </LinkGroup>
        ))
      }
    </div>

    <div
      class="flex flex-col gap-3 border-t py-6 text-sm text-muted-foreground sm:flex-row sm:items-center sm:justify-between"
    >
      <span>© {year} {brand}. All rights reserved.</span>
      <nav aria-label="Legal" class="flex gap-5">
        <a href="#privacy" class="hover:text-foreground">Privacy</a>
        <a href="#terms" class="hover:text-foreground">Terms</a>
      </nav>
    </div>
    <div
      aria-hidden="true"
      class="overflow-hidden pb-4 text-center text-[clamp(5rem,20vw,14rem)] font-bold leading-[0.8] tracking-tighter text-foreground/10"
    >
      {brand}
    </div>
  </div>
</footer>
