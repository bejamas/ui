---
/**
 * Astro port of a shadcnblocks.com block.
 * Copyright (c) 2025 shadcnblocks.com - Rob Austin. MIT + Commons Clause.
 * Retain upstream notice; redistribution of component ports requires permission.
 */
import { ArrowRight } from "@lucide/astro";
interface Props {
  heading?: string;
  description?: string;
  link?: { text: string; url: string };
  stats?: Array<{ id: string; value: string; label: string }>;
  class?: string;
}
const {
  heading = "Platform performance insights",
  description = "Ensuring stability and scalability for all users",
  link = {
    text: "Read the full impact report",
    url: "https://www.shadcnblocks.com",
  },
  stats = [
    {
      id: "stat-1",
      value: "250%+",
      label: "average growth in user engagement",
    },
    {
      id: "stat-2",
      value: "$2.5m",
      label: "annual savings per enterprise partner",
    },
    {
      id: "stat-3",
      value: "200+",
      label: "integrations with top industry platforms",
    },
    {
      id: "stat-4",
      value: "99.9%",
      label: "customer satisfaction over the last year",
    },
  ],
  class: className,
} = Astro.props;
---

<section data-block="stats-01" class:list={["py-32", className]}>
  <div class="mx-auto w-full px-8 sm:max-w-[640px] md:max-w-[768px] lg:max-w-[1024px] xl:max-w-[1280px] 2xl:max-w-[1536px]">
    <div class="flex flex-col gap-4">
      <h2 class="text-2xl font-bold md:text-4xl">{heading}</h2>
      <p>{description}</p>
      <a
        href={link.url}
        class="flex items-center gap-1 font-bold hover:underline"
      >
        {link.text}
        <ArrowRight class="h-auto w-4" />
      </a>
    </div>
    <div class="mt-14 grid gap-x-5 gap-y-8 md:grid-cols-2 lg:grid-cols-4">
      {stats.map((stat) => (
        <div class="flex flex-col gap-5">
          <div class="text-6xl font-bold">{stat.value}</div>
          <p>{stat.label}</p>
        </div>
      ))}
    </div>
  </div>
</section>
