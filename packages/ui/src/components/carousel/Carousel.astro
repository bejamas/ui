 *
 * @usage
 *
 * ```astro nocollapse
 * ---
 * import { Carousel, CarouselSlide } from '@bejamas/ui/components/carousel';
 * ---
 *
 * <Carousel aria-label="Featured cards" class="max-w-sm">
 *   <CarouselSlide><div class="rounded-lg bg-muted p-6">Card 1</div></CarouselSlide>
 *   <CarouselSlide><div class="rounded-lg bg-muted p-6">Card 2</div></CarouselSlide>
 *   <CarouselSlide><div class="rounded-lg bg-muted p-6">Card 3</div></CarouselSlide>
 * </Carousel>
 * ```
 *
 * @props
 * - orientation?: "horizontal" | "vertical" — Direction of navigation. Default: "horizontal".
 * - variant?: "single" | "multiple" — One card or two cards per page. Default: "single".
 * - defaultIndex?: number — Initial page index (zero-based). Default: 0.
 * - loop?: boolean — Wrap navigation at the first and last pages. Default: false.
 * - drag?: boolean — Enable mouse and touch dragging. Default: true.
 * - controls?: boolean — Show previous and next buttons. Default: true.
 * - showCounter?: boolean — Show the current page counter. Defaults to true for horizontal single carousels.
 * - counterLabel?: string — Counter prefix. Defaults to "Card" for single and "Page" for multiple.
 * - previousLabel?: string — Accessible previous button label. Default: "Previous slide".
 * - nextLabel?: string — Accessible next button label. Default: "Next slide".
 * - contentClass?: string — Classes for the scroll viewport, including vertical height.
 * - axis?: "x" | "y" — Legacy orientation alias. Explicit orientation takes precedence.
 * - snapType?: "mandatory" | "proximity" — Native snap behavior. Default: "mandatory".
 * - fade?: boolean — Fade the viewport edges. Default: false.
 *
