 *   <CarouselSlide><div class="flex items-center justify-center rounded-lg bg-muted text-muted-foreground font-semibold aspect-4/5">2</div></CarouselSlide>
 *   <CarouselSlide><div class="flex items-center justify-center rounded-lg bg-muted text-muted-foreground font-semibold aspect-4/5">3</div></CarouselSlide>
 *   <CarouselSlide><div class="flex items-center justify-center rounded-lg bg-muted text-muted-foreground font-semibold aspect-4/5">4</div></CarouselSlide>
 *   <CarouselSlide><div class="flex items-center justify-center rounded-lg bg-muted text-muted-foreground font-semibold aspect-4/5">5</div></CarouselSlide>
 * </Carousel>
 *
 * ### Horizontal multiple
 *
 * <Carousel aria-label="Horizontal multiple cards" variant="multiple" class="mx-auto max-w-108">
 *   <CarouselSlide>
 *     <div class="flex items-center justify-center rounded-lg bg-muted text-muted-foreground font-semibold aspect-4/5">1</div>
 *     <div class="flex items-center justify-center rounded-lg bg-muted text-muted-foreground font-semibold aspect-4/5">2</div>
 *   </CarouselSlide>
 *   <CarouselSlide>
 *     <div class="flex items-center justify-center rounded-lg bg-muted text-muted-foreground font-semibold aspect-4/5">3</div>
 *     <div class="flex items-center justify-center rounded-lg bg-muted text-muted-foreground font-semibold aspect-4/5">4</div>
 *   </CarouselSlide>
 *   <CarouselSlide>
 *     <div class="flex items-center justify-center rounded-lg bg-muted text-muted-foreground font-semibold aspect-4/5">5</div>
 *     <div class="flex items-center justify-center rounded-lg bg-muted text-muted-foreground font-semibold aspect-4/5">6</div>
 *   </CarouselSlide>
 * </Carousel>
 *
 * ### Vertical single
 *
 * <Carousel aria-label="Vertical single cards" orientation="vertical" class="mx-auto max-w-75" contentClass="h-50">
 *   <CarouselSlide><div class="flex items-center justify-center rounded-lg bg-muted text-muted-foreground font-semibold h-full">1</div></CarouselSlide>
 *   <CarouselSlide><div class="flex items-center justify-center rounded-lg bg-muted text-muted-foreground font-semibold h-full">2</div></CarouselSlide>
 *   <CarouselSlide><div class="flex items-center justify-center rounded-lg bg-muted text-muted-foreground font-semibold h-full">3</div></CarouselSlide>
 *   <CarouselSlide><div class="flex items-center justify-center rounded-lg bg-muted text-muted-foreground font-semibold h-full">4</div></CarouselSlide>
 *   <CarouselSlide><div class="flex items-center justify-center rounded-lg bg-muted text-muted-foreground font-semibold h-full">5</div></CarouselSlide>
 * </Carousel>
 *
 * ### Vertical multiple
 *
 * <Carousel aria-label="Vertical multiple cards" orientation="vertical" variant="multiple" class="mx-auto max-w-75" contentClass="h-79">
 *   <CarouselSlide>
 *     <div class="flex items-center justify-center rounded-lg bg-muted text-muted-foreground font-semibold min-h-0">1</div>
 *     <div class="flex items-center justify-center rounded-lg bg-muted text-muted-foreground font-semibold min-h-0">2</div>
 *   </CarouselSlide>
 *   <CarouselSlide>
 *     <div class="flex items-center justify-center rounded-lg bg-muted text-muted-foreground font-semibold min-h-0">3</div>
 *     <div class="flex items-center justify-center rounded-lg bg-muted text-muted-foreground font-semibold min-h-0">4</div>
 *   </CarouselSlide>
 *   <CarouselSlide>
 *     <div class="flex items-center justify-center rounded-lg bg-muted text-muted-foreground font-semibold min-h-0">5</div>
 *     <div class="flex items-center justify-center rounded-lg bg-muted text-muted-foreground font-semibold min-h-0">6</div>
 *   </CarouselSlide>
 * </Carousel>
 *
 * ## Navigation and accessibility
 *
 * Use the previous and next buttons, drag with a mouse, or swipe with touch. Focus the slide viewport to use Left/Right (horizontal), Up/Down (vertical), Home, or End. Data-slot manages slide semantics, inactive content, disabled controls, and reduced-motion scrolling. Give each carousel an accessible name with `aria-label` or `aria-labelledby`.
 *
 * ## Multiple cards
 *
 * Each `CarouselSlide` is one full viewport page and can contain any number of elements. Navigation advances one page at a time, keeping all content in the active slide accessible. A counter on this variant counts pages.
 *
 * ## Sizing
 *
 * Use `class` for the carousel's outer width and `contentClass` for the viewport. Vertical carousels need an explicit viewport height.
 *
 * @api
 *
 * ### Events
 *
 * The carousel emits custom events on its root element:
 *
 * | Event | Detail | Description |
 * |-------|--------|-------------|
 * | `carousel:change` | `{ index: number }` | Fired when the active slide changes. The index is zero-based. |
 *
 * ```astro nocollapse
 * <Carousel id="my-carousel" aria-label="Featured cards" class="max-w-sm">
 *   <CarouselSlide><div class="rounded-lg bg-muted p-6">Card 1</div></CarouselSlide>
 *   <CarouselSlide><div class="rounded-lg bg-muted p-6">Card 2</div></CarouselSlide>
 *   <CarouselSlide><div class="rounded-lg bg-muted p-6">Card 3</div></CarouselSlide>
 * </Carousel>
 * ```
 *
 * ```js nocollapse
 * const carousel = document.getElementById('my-carousel');
 *
 * carousel.addEventListener('carousel:change', (event) => {
 *   console.log('Active slide:', event.detail.index);
 * });
 * ```
 *
 * ### Programmatic Control
 *
 * Dispatch `carousel:set` on the root to select a slide or navigate:
 *
 * ```js nocollapse
 * const carousel = document.getElementById('my-carousel');
 *
 * // Select the third slide (zero-based index).
 * carousel.dispatchEvent(new CustomEvent('carousel:set', {
 *   detail: { index: 2 }
 * }));
 *
 * // Move to the next slide.
 * carousel.dispatchEvent(new CustomEvent('carousel:set', {
 *   detail: { action: 'next' }
 * }));
 *
 * // Move to the previous slide.
 * carousel.dispatchEvent(new CustomEvent('carousel:set', {
 *   detail: { action: 'prev' }
 * }));
 * ```
 *
 * ### Data Attributes
 *
 * The carousel exposes these attributes for styling and state queries:
 *
 * | Attribute | Element | Description |
 * |-----------|---------|-------------|
 * | `data-orientation` | carousel | Current orientation (`horizontal` or `vertical`) |
 * | `data-variant` | carousel | Layout variant (`single` or `multiple`) |
 * | `data-index` | carousel | Zero-based index of the active slide |
 * | `data-dragging` | carousel | Present during an active drag gesture |
 * | `data-state` | carousel-item | Current slide state (`active` or `inactive`) |
 */
import type { HTMLAttributes } from "astro/types";
import { cn } from "@bejamas/ui/lib/utils";
import Button from "../button/Button.astro";
import SemanticIcon from "../icon/SemanticIcon.astro";

interface Props extends HTMLAttributes<"div"> {
  orientation?: "horizontal" | "vertical";
  variant?: "single" | "multiple";
  defaultIndex?: number;
  loop?: boolean;
  drag?: boolean;
  controls?: boolean;
  showCounter?: boolean;
  counterLabel?: string;
  previousLabel?: string;
  nextLabel?: string;
  contentClass?: string;
  axis?: "x" | "y";
  snapType?: "mandatory" | "proximity";
  fade?: boolean;
  class?: string;
}

const {
  axis = "x",
  orientation = axis === "y" ? "vertical" : "horizontal",
  variant = "single",
  defaultIndex = 0,
  loop = false,
  drag = true,
  controls = true,
  showCounter = orientation === "horizontal" && variant === "single",
  counterLabel = variant === "multiple" ? "Page" : "Card",
  previousLabel = "Previous slide",
  nextLabel = "Next slide",
  contentClass,
  snapType = "mandatory",
  fade = false,
  class: className,
  "aria-label": ariaLabel = "Carousel",
  ...rest
} = Astro.props;
const vertical = orientation === "vertical";
---

<div
  {...rest}
  role="region"
  aria-roledescription="carousel"
  aria-label={ariaLabel}
  data-slot="carousel"
  data-orientation={orientation}
  data-variant={variant}
  data-default-index={defaultIndex}
  data-loop={String(loop)}
  data-drag={String(drag)}
  data-counter-label={counterLabel}
  class={cn(
    "group/carousel relative grid w-full min-w-0 items-center gap-x-4 gap-y-2",
    vertical
      ? "grid-cols-1 justify-items-center gap-y-4"
      : "grid-cols-[auto_minmax(0,1fr)_auto]",
    !controls && "grid-cols-1",
    className,
  )}
>
  {controls && (
    <Button
      type="button"
      variant="outline"
      size="icon-sm"
      data-slot="carousel-previous"
      aria-label={previousLabel}
      class="cn-carousel-previous"
    >
      <SemanticIcon
        name="chevron-right"
        class={cn("size-4", vertical ? "-rotate-90" : "rotate-180")}
      />
    </Button>
  )}
  <div
    data-slot="carousel-content"
    tabindex="0"
    role="group"
    aria-label="Slides"
    class={cn(
      "flex min-h-0 min-w-0 w-full gap-4 overflow-auto overscroll-contain rounded-lg outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:ring-offset-background [scrollbar-width:none] [&::-webkit-scrollbar]:hidden",
      vertical ? "flex-col snap-y" : "snap-x",
      snapType === "mandatory" ? "snap-mandatory" : "snap-proximity",
      drag && "cursor-grab group-data-[dragging=true]/carousel:cursor-grabbing",
      fade &&
        (vertical
          ? "mask-y-from-80% mask-y-to-95%"
          : "mask-x-from-80% mask-x-to-95%"),
      contentClass,
    )}
  >
    <slot />
  </div>
  {controls && (
    <Button
      type="button"
      variant="outline"
      size="icon-sm"
      data-slot="carousel-next"
      aria-label={nextLabel}
      class="cn-carousel-next"
    >
      <SemanticIcon
        name="chevron-right"
        class={cn("size-4", vertical && "rotate-90")}
      />
    </Button>
  )}
  {showCounter && (
    <p
      data-slot="carousel-counter"
      role="status"
      aria-live="polite"
      aria-atomic="true"
      class={cn(
        "text-center text-xs font-medium text-muted-foreground",
        !vertical && controls && "col-span-3",
      )}
    />
  )}
</div>

<script>
  import { createCarousel, type CarouselController } from "@data-slot/carousel";

  const carousels = new Map<HTMLElement, CarouselController>();

  function initializeCarousels() {
    document
      .querySelectorAll<HTMLElement>('[data-slot="carousel"]')
      .forEach((root) => {
        if (carousels.has(root)) return;
        const content = root.querySelector('[data-slot="carousel-content"]');
        if (!content?.querySelector(':scope > [data-slot="carousel-item"]'))
          return;
        const counter = root.querySelector<HTMLElement>(
          ':scope > [data-slot="carousel-counter"]',
        );
        const updateCounter = () => {
          const carousel = carousels.get(root);
          if (counter && carousel) {
            counter.textContent = carousel.count
              ? `${root.dataset.counterLabel} ${carousel.index + 1} of ${carousel.count}`
              : "";
          }
        };
        const carousel = createCarousel(root, { onIndexChange: updateCounter });
        carousels.set(root, carousel);
        updateCounter();
      });
  }

  initializeCarousels();
  document.addEventListener("astro:page-load", initializeCarousels);
  document.addEventListener("astro:before-swap", () => {
    carousels.forEach((carousel) => carousel.destroy());
    carousels.clear();
  });
</script>
