/**
 * @component Carousel
 * @title Carousel
 * @description An accessible, draggable carousel powered by data-slot, with horizontal and vertical layouts.
 *
 * @preview
 *
 * <Carousel aria-label="Horizontal single cards" class="mx-auto max-w-86.5">
 *   <CarouselSlide><div class="flex items-center justify-center rounded-lg bg-muted text-muted-foreground font-semibold aspect-4/5">1</div></CarouselSlide>
