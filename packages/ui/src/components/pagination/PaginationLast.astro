---
// Generated from bejamas-juno style registry. Do not edit packages/ui/src/components/pagination/PaginationLast.astro directly.
import type { Props as PaginationLinkProps } from "./PaginationLink.astro";
import { cn } from "@bejamas/ui/lib/utils";
import SemanticIcon from "../icon/SemanticIcon.astro";
import PaginationLink from "./PaginationLink.astro";

type Props = PaginationLinkProps & {
  text?: string;
};

const {
  text = "Last",
  size,
  class: className = "",
  "aria-label": ariaLabel = "Go to last page",
  ...rest
} = Astro.props as Props;

// An empty `text` renders an icon-only control.
const iconOnly = !text;
---

<PaginationLink
  {...rest}
  aria-label={ariaLabel}
  size={size ?? (iconOnly ? "icon" : "default")}
  class={cn(!iconOnly && "pr-2!", className)}
>
  {iconOnly ? null : <span class="hidden sm:block">{text}</span>}
  <SemanticIcon
    name="chevrons-right"
    data-icon="inline-end"
    class="rtl:rotate-180"
  />
</PaginationLink>
