  aria-current={isActive ? "page" : undefined}
  aria-disabled={disabled ? "true" : undefined}
  data-slot="pagination-link"
  data-active={isActive ? "true" : "false"}
  class={cn(
    "aria-disabled:pointer-events-none aria-disabled:opacity-50",
    className,
  )}
>
  <slot />
</Button>
