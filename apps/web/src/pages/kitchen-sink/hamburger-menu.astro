---
import KitchenSinkLayout from "@/components/KitchenSinkLayout.astro";
import HamburgerMenuExample from "@/components/HamburgerMenuExample.astro";
import {
  HamburgerMenu,
  HamburgerMenuBar,
  HamburgerMenuLink,
  HamburgerMenuPanel,
  HamburgerMenuSection,
} from "@bejamas/registry/ui/hamburger-menu";
---

<KitchenSinkLayout>
  <section class="mx-auto max-w-5xl space-y-8 px-5 py-20">
    <h1 class="text-3xl font-bold">Hamburger Menu</h1>
    <p class="text-muted-foreground">
      Open the menus with mouse, touch, or keyboard. Press Escape to close one.
    </p>

    <div class="space-y-3">
      <h2 class="text-lg font-semibold">Closed</h2>
      <div class="relative w-full max-w-[375px] overflow-hidden rounded-lg border border-border [--hamburger-menu-panel-height:688px] [&:has([data-state=open])]:h-[736px]">
        <HamburgerMenuExample closeOnFocusOutside />
      </div>
    </div>

    <div class="grid gap-8 lg:grid-cols-2">
      <div class="space-y-3">
        <h2 class="text-lg font-semibold">Opened With Links</h2>
        <div class="relative w-full max-w-[375px] overflow-hidden rounded-lg border border-border [--hamburger-menu-panel-height:688px] [&:has([data-state=open])]:h-[736px]">
          <HamburgerMenuExample defaultOpen closeOnOutsideClick={false} />
        </div>
      </div>
      <div class="space-y-3">
        <h2 class="text-lg font-semibold">Opened With Groups</h2>
        <div class="relative w-full max-w-[375px] overflow-hidden rounded-lg border border-border [--hamburger-menu-panel-height:688px] [&:has([data-state=open])]:h-[736px]">
          <HamburgerMenuExample
            withGroups
            defaultOpen
            closeOnOutsideClick={false}
          />
        </div>
      </div>
    </div>

    <div class="space-y-3">
      <h2 class="text-lg font-semibold">Customized Content</h2>
      <div class="relative w-full max-w-[375px] overflow-hidden rounded-lg border border-border [--hamburger-menu-panel-height:320px] [&:has([data-state=open])]:h-[368px]">
        <HamburgerMenu closeOnOutsideClick={false}>
          <HamburgerMenuBar
            defaultOpen
            class="px-5"
            triggerClass="rounded-full bg-muted"
          >
            <a href="/" class="font-semibold">
              Bejamas UI
            </a>
            <span slot="trigger-open" class="text-[10px] font-semibold">
              Menu
            </span>
            <span slot="trigger-close" class="text-[10px] font-semibold">
              Close
            </span>
          </HamburgerMenuBar>
          <HamburgerMenuPanel label="Example navigation" class="px-5">
            <p slot="header" class="mb-4 text-sm text-muted-foreground">
              Explore the site
            </p>
            <HamburgerMenuSection label="Resources">
              <HamburgerMenuLink href="/docs">Documentation</HamburgerMenuLink>
              <HamburgerMenuLink href="/components">
                Components
              </HamburgerMenuLink>
            </HamburgerMenuSection>
          </HamburgerMenuPanel>
        </HamburgerMenu>
      </div>
    </div>
  </section>
</KitchenSinkLayout>
