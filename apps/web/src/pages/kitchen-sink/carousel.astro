---
import KitchenSinkLayout from "@/components/KitchenSinkLayout.astro";
import KitchenSinkSection from "@/components/KitchenSinkSection.astro";
import { Carousel, CarouselSlide } from "@bejamas/registry/ui/carousel";
---

<KitchenSinkLayout>
  <section class="mx-auto max-w-5xl space-y-12 px-5 py-20">
    <h1 class="text-3xl font-bold">Carousel</h1>
    <p class="text-muted-foreground">
      Navigate with the buttons, arrow keys, Home or End. Drag or swipe to
      change pages.
    </p>
    <div class="grid gap-8 lg:grid-cols-2">
      <KitchenSinkSection title="Horizontal Single">
        <Carousel
          aria-label="Horizontal single cards"
          class="mx-auto max-w-86.5"
        >
          <CarouselSlide>
            <div class="flex items-center justify-center rounded-lg bg-muted text-muted-foreground font-semibold aspect-4/5">
              1
            </div>
          </CarouselSlide>
          <CarouselSlide>
            <div class="flex items-center justify-center rounded-lg bg-muted text-muted-foreground font-semibold aspect-4/5">
              2
            </div>
          </CarouselSlide>
          <CarouselSlide>
            <div class="flex items-center justify-center rounded-lg bg-muted text-muted-foreground font-semibold aspect-4/5">
              3
            </div>
          </CarouselSlide>
          <CarouselSlide>
            <div class="flex items-center justify-center rounded-lg bg-muted text-muted-foreground font-semibold aspect-4/5">
              4
            </div>
          </CarouselSlide>
          <CarouselSlide>
            <div class="flex items-center justify-center rounded-lg bg-muted text-muted-foreground font-semibold aspect-4/5">
              5
            </div>
          </CarouselSlide>
        </Carousel>
      </KitchenSinkSection>
      <KitchenSinkSection title="Horizontal Multiple">
        <Carousel
          aria-label="Horizontal multiple cards"
          variant="multiple"
          class="mx-auto max-w-108"
        >
          <CarouselSlide>
            <div class="flex items-center justify-center rounded-lg bg-muted text-muted-foreground font-semibold aspect-4/5">
              1
            </div>
            <div class="flex items-center justify-center rounded-lg bg-muted text-muted-foreground font-semibold aspect-4/5">
              2
            </div>
          </CarouselSlide>
          <CarouselSlide>
            <div class="flex items-center justify-center rounded-lg bg-muted text-muted-foreground font-semibold aspect-4/5">
              3
            </div>
            <div class="flex items-center justify-center rounded-lg bg-muted text-muted-foreground font-semibold aspect-4/5">
              4
            </div>
          </CarouselSlide>
          <CarouselSlide>
            <div class="flex items-center justify-center rounded-lg bg-muted text-muted-foreground font-semibold aspect-4/5">
              5
            </div>
            <div class="flex items-center justify-center rounded-lg bg-muted text-muted-foreground font-semibold aspect-4/5">
              6
            </div>
          </CarouselSlide>
        </Carousel>
      </KitchenSinkSection>
      <KitchenSinkSection title="Vertical Single">
        <Carousel
          aria-label="Vertical single cards"
          orientation="vertical"
          class="mx-auto max-w-75"
          contentClass="h-50"
        >
          <CarouselSlide>
            <div class="flex items-center justify-center rounded-lg bg-muted text-muted-foreground font-semibold h-full">
              1
            </div>
          </CarouselSlide>
          <CarouselSlide>
            <div class="flex items-center justify-center rounded-lg bg-muted text-muted-foreground font-semibold h-full">
              2
            </div>
          </CarouselSlide>
          <CarouselSlide>
            <div class="flex items-center justify-center rounded-lg bg-muted text-muted-foreground font-semibold h-full">
              3
            </div>
          </CarouselSlide>
          <CarouselSlide>
            <div class="flex items-center justify-center rounded-lg bg-muted text-muted-foreground font-semibold h-full">
              4
            </div>
          </CarouselSlide>
          <CarouselSlide>
            <div class="flex items-center justify-center rounded-lg bg-muted text-muted-foreground font-semibold h-full">
              5
            </div>
          </CarouselSlide>
        </Carousel>
      </KitchenSinkSection>
      <KitchenSinkSection title="Vertical Multiple">
        <Carousel
          aria-label="Vertical multiple cards"
          orientation="vertical"
          variant="multiple"
          class="mx-auto max-w-75"
          contentClass="h-79"
        >
          <CarouselSlide>
            <div class="flex items-center justify-center rounded-lg bg-muted text-muted-foreground font-semibold min-h-0">
              1
            </div>
            <div class="flex items-center justify-center rounded-lg bg-muted text-muted-foreground font-semibold min-h-0">
              2
            </div>
          </CarouselSlide>
          <CarouselSlide>
            <div class="flex items-center justify-center rounded-lg bg-muted text-muted-foreground font-semibold min-h-0">
              3
            </div>
            <div class="flex items-center justify-center rounded-lg bg-muted text-muted-foreground font-semibold min-h-0">
              4
            </div>
          </CarouselSlide>
          <CarouselSlide>
            <div class="flex items-center justify-center rounded-lg bg-muted text-muted-foreground font-semibold min-h-0">
              5
            </div>
            <div class="flex items-center justify-center rounded-lg bg-muted text-muted-foreground font-semibold min-h-0">
              6
            </div>
          </CarouselSlide>
        </Carousel>
      </KitchenSinkSection>
    </div>
    <KitchenSinkSection title="Looping with an initial slide">
      <Carousel
        aria-label="Looping cards"
        loop
        defaultIndex={2}
        class="mx-auto max-w-86.5"
      >
        {[1, 2, 3, 4, 5].map((number) => (
          <CarouselSlide>
            <div class="flex aspect-4/5 items-center justify-center rounded-lg bg-muted font-semibold text-muted-foreground">
              {number}
            </div>
          </CarouselSlide>
        ))}
      </Carousel>
    </KitchenSinkSection>
  </section>
</KitchenSinkLayout>
