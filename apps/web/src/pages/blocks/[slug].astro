---
import BlocksLayout from "@/components/BlocksLayout.astro";
import BlockPreview from "@/components/BlockPreview.astro";
import { shadcnblocksCategories } from "@/lib/block-gallery";

export const prerender = true;

export function getStaticPaths() {
  const aliases = {
    features: "/blocks/feature",
    testimonials: "/blocks/testimonial",
    authentication: "/blocks/login",
    "navigation-headers": "/blocks",
    footers: "/blocks",
  };
  return [
    ...shadcnblocksCategories.map((category) => ({
      params: { slug: category.slug },
      props: { category, redirect: undefined },
    })),
    ...Object.entries(aliases).map(([slug, redirect]) => ({
      params: { slug },
      props: { category: undefined, redirect },
    })),
  ];
}

const { category, redirect } = Astro.props;
if (redirect) return Astro.redirect(redirect, 301);
---

<BlocksLayout category={category?.label}>
  {category?.items.map((item) => (
    <BlockPreview item={item} />
  ))}
</BlocksLayout>
