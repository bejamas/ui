---
import BlocksNav from "@/components/BlocksNav.astro";
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
import { ArrowUpRight } from "@lucide/astro";

interface Props {
  category?: string;
}
const { category } = Astro.props;
---

<StarlightPage
  hasSidebar={true}
  frontmatter={{
    title: `${category ? `${category} blocks` : "Blocks"} for Astro`,
    description:
      "Ready-to-use sections built with Astro and b/ui. Preview, customize, and copy the code into your project.",
    template: "splash",
  }}
>
  <div class="not-content" data-page-scope="blocks">
    <BlocksNav />
    <div class="space-y-16 pb-16" id="block-collection">
      <slot />
    </div>
    <aside class="border-t border-border py-8 text-sm">
      <p class="flex flex-wrap items-center gap-x-2 gap-y-1 text-muted-foreground">
        Looking for more designs?
        <a
          href="https://www.shadcnblocks.com/pricing"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1 font-medium text-foreground hover:underline underline-offset-4"
        >
          Explore Shadcnblocks' premium collection
          <ArrowUpRight class="size-3.5" />
        </a>
      </p>
      <p class="mt-2 text-xs text-muted-foreground">
        Sold by Shadcnblocks. Premium blocks haven't been adapted for Astro +
        b/ui yet.
      </p>
    </aside>
  </div>
</StarlightPage>

<style is:global>
  :root:has([data-page-scope="blocks"]) .content-panel {
    border: 0;
    padding-block: 0;
  }
  :root:has([data-page-scope="blocks"]) .sl-container {
    margin-inline: auto;
    max-width: 1500px;
  }

  :root:has([data-page-scope="blocks"]) .footer-wide {
    width: 100%;
    margin-inline: 0;
    padding-inline: 0;
  }
</style>
