---
import {
  Tabs,
  TabsList,
  TabsTrigger,
  TabsContent,
} from "@bejamas/ui/components/tabs";
import { Button } from "@bejamas/ui/components/button";
import {
  Laptop,
  Tablet,
  Smartphone,
  Terminal,
  Check,
  ChevronRight,
  ArrowUpRight,
} from "@lucide/astro";
import ShadcnblocksLogo from "@/assets/shadcnblocks-logo.svg";
import Source from "@/components/Source.astro";
import {
  getBlockInstallCommand,
  type ShadcnblocksItem,
} from "@/lib/block-gallery";

interface Props {
  item: ShadcnblocksItem;
}
const { item } = Astro.props;
const installCommand = getBlockInstallCommand(item.id);
---

<section
  id={item.id}
  aria-labelledby={`${item.id}-title`}
  x-data="{ size: 'desktop' }"
>
  <div class="mb-5 flex flex-wrap items-start justify-between gap-4">
    <div class="min-w-0">
      <nav
        aria-label={`${item.label} breadcrumb`}
        class="mb-3 text-xs text-muted-foreground"
      >
        <ol class="m-0 flex list-none flex-wrap items-center gap-1.5 p-0">
          <li>
            <a
              href={`/blocks/${item.sourceCategory.toLowerCase()}`}
              class="hover:text-foreground"
            >
              {item.sourceCategory}
            </a>
          </li>
          <li aria-hidden="true">
            <ChevronRight class="size-3" />
          </li>
          <li aria-current="location" class="text-foreground">
            {item.label}
          </li>
        </ol>
      </nav>
      <div class="flex items-center gap-3">
        <h2
          id={`${item.id}-title`}
          class="text-xl font-semibold tracking-tight"
        >
          {item.label}
        </h2>
        <span class="rounded-md bg-muted px-2 py-0.5 text-xs font-medium text-muted-foreground">
          Free
        </span>
      </div>
      <p class="mt-1.5 text-sm text-muted-foreground">{item.description}</p>
    </div>
    <a
      href={item.sourceUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex shrink-0 items-center gap-2 text-xs text-muted-foreground hover:text-foreground"
    >
      <ShadcnblocksLogo class="h-4 w-3.5" aria-hidden="true" />
      {item.label} on Shadcnblocks <ArrowUpRight class="size-3.5" />
    </a>
  </div>
  <Tabs defaultValue="preview">
    <div class="flex flex-wrap justify-between gap-3 mb-3 items-center">
      <TabsList size="sm" variant="default" class="space-x-0.5">
        <TabsTrigger
          value="preview"
          class="aria-selected:bg-primary aria-selected:text-primary-foreground h-8 px-2.5"
        >
          Preview
        </TabsTrigger>
        <TabsTrigger
          value="source"
          class="aria-selected:bg-primary aria-selected:text-primary-foreground h-8 px-2.5"
        >
          Source
        </TabsTrigger>
      </TabsList>
      <div class="flex flex-wrap gap-0.5 items-center">
        <Button
          size="icon"
          variant="ghost"
          title="Desktop"
          aria-label="Desktop preview"
          x-bind:aria-pressed="size === 'desktop'"
          class="size-8"
          @click="size = 'desktop'"
        >
          <Laptop class="size-4" />
        </Button>
        <Button
          size="icon"
          variant="ghost"
          title="Tablet"
          aria-label="Tablet preview"
          x-bind:aria-pressed="size === 'tablet'"
          class="size-8"
          @click="size = 'tablet'"
        >
          <Tablet class="size-4" />
        </Button>
        <Button
          size="icon"
          variant="ghost"
          title="Smartphone"
          aria-label="Smartphone preview"
          x-bind:aria-pressed="size === 'smartphone'"
          class="size-8"
          @click="size = 'smartphone'"
        >
          <Smartphone class="size-4" />
        </Button>
        <button
          x-data={`{ copied: false, command: ${JSON.stringify(installCommand)} }`}
          @click="await navigator.clipboard.writeText(command); copied = true; setTimeout(() => copied = false, 2000)"
          class="bg-muted/50 sm:ml-2 border flex max-w-full items-center rounded-md text-xs px-2 py-2 cursor-pointer select-none hover:bg-muted/80 min-h-8 transition-colors duration-200 ease-out"
          title="Copy install command"
          aria-label={`Copy install command for ${item.label}`}
        >
          <span x-show="!copied">
            <Terminal class="size-4 mr-2" />
          </span>
          <span x-show="copied" x-cloak>
            <Check class="size-4 mr-2" />
          </span>
          <code class="text-left break-all">{installCommand}</code>
          <span
            class="sr-only"
            role="status"
            x-text="copied ? 'Copied!' : ''"
          ></span>
        </button>
      </div>
    </div>
    <TabsContent value="preview">
      <iframe
        data-block-preview
        title={`${item.label} preview`}
        loading="lazy"
        src={item.href}
        class="mx-auto block w-full h-full min-h-[800px] border border-border rounded-2xl data-[size='desktop']:max-w-full data-[size='tablet']:max-w-3xl data-[size='smartphone']:max-w-sm"
        :data-size="size"
      ></iframe>
    </TabsContent>
    <TabsContent value="source">
      <Source blockId={item.id} />
    </TabsContent>
  </Tabs>
</section>

<style>
  [x-cloak] {
    display: none !important;
  }
</style>

<script>
  import { PRESET_CHANGE_EVENT } from "@/utils/themes/preset-store";
  import { PRESET_CHANGE_MESSAGE } from "@/utils/themes/theme-stylesheet";

  // Previews are separate documents; tell them the header switched presets.
  window.addEventListener(PRESET_CHANGE_EVENT, (event) => {
    const { detail } = event as CustomEvent<unknown>;
    for (const frame of document.querySelectorAll<HTMLIFrameElement>(
      "iframe[data-block-preview]",
    )) {
      frame.contentWindow?.postMessage(
        { type: PRESET_CHANGE_MESSAGE, detail },
        window.location.origin,
      );
    }
  });
</script>
