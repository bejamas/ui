---
import {
  Tabs,
  TabsList,
  TabsTrigger,
  TabsContent,
} from "@bejamas/ui/components/tabs";
import { Button } from "@bejamas/ui/components/button";
import { Laptop, Tablet, Smartphone, Terminal, Check } from "@lucide/astro";
import Source from "@/components/Source.astro";
import {
  getBlockInstallCommand,
  type BlockGalleryItem,
} from "@/lib/block-gallery";

const { item } = Astro.props as { item: BlockGalleryItem };
const installCommand = getBlockInstallCommand(item.id);
---

<div x-data="{ size: 'desktop' }">
  <Tabs defaultValue="preview">
    <div class="flex justify-between mb-3 items-center">
      <TabsList size="sm" variant="default" class="space-x-0.5">
        <TabsTrigger
          value="preview"
          class="aria-selected:bg-primary aria-selected:text-primary-foreground h-8 px-2.5"
          >Preview</TabsTrigger
        >
        <TabsTrigger
          value="source"
          class="aria-selected:bg-primary aria-selected:text-primary-foreground h-8 px-2.5"
          >Source</TabsTrigger
        >
      </TabsList>
      <div class="flex space-x-0.5 items-center">
        <Button
          size="icon"
          variant="ghost"
          title="Desktop"
          class="size-8"
          @click="size = 'desktop'"
        >
          <Laptop class="size-4" />
        </Button>
        <Button
          size="icon"
          variant="ghost"
          title="Tablet"
          class="size-8"
          @click="size = 'tablet'"
        >
          <Tablet class="size-4" />
        </Button>
        <Button
          size="icon"
          variant="ghost"
          title="Smartphone"
          class="size-8"
          @click="size = 'smartphone'"
        >
          <Smartphone class="size-4" />
        </Button>
        <button
          x-data={`{ copied: false, command: ${JSON.stringify(installCommand)} }`}
          @click="navigator.clipboard.writeText(command); copied = true; setTimeout(() => copied = false, 2000)"
          class="bg-muted/50 ml-2 border flex items-center rounded-md text-xs px-2 py-2 cursor-pointer select-none hover:bg-muted/80 h-8 transition-colors duration-200 ease-out"
          title="Copy install command"
        >
          <span x-show="!copied"><Terminal class="size-4 mr-2" /></span>
          <span x-show="copied"><Check class="size-4 mr-2" /></span>
          <code>{installCommand}</code>
        </button>
      </div>
    </div>
    <TabsContent value="preview">
      <iframe
        src={item.href}
        class="w-full h-full min-h-[800px] border border-border rounded-2xl data-[size='desktop']:max-w-full data-[size='tablet']:max-w-3xl data-[size='smartphone']:max-w-sm"
        :data-size="size"></iframe>
    </TabsContent>
    <TabsContent value="source">
      <Source blockId={item.id} />
    </TabsContent>
  </Tabs>
</div>
