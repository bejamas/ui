---
import { Button } from "@bejamas/registry/ui/button";
import { SemanticIcon } from "@bejamas/registry/ui/icon";
import {
  HamburgerMenu,
  MenuGroup,
  MenuItem,
} from "@bejamas/registry/ui/hamburger-menu";

interface Props {
  withGroups?: boolean;
  defaultOpen?: boolean;
  closeOnOutsideClick?: boolean;
}

const {
  withGroups = false,
  defaultOpen = false,
  closeOnOutsideClick = true,
} = Astro.props;

const simpleLinks = [
  ["Getting started", "#getting-started"],
  ["Installation", "#installation"],
  ["Components", "#components"],
  ["Concepts", "#concepts"],
  ["Blog", "#blog"],
  ["About us", "#about"],
  ["Contact us", "#contact"],
  ["FAQ", "#faq"],
] as const;

const groups = [
  {
    label: "Getting started",
    links: [
      ["Introduction", "#introduction"],
      ["Installation", "#installation-advanced"],
      ["CLI", "#cli"],
      ["Forms with Astro Actions", "#forms"],
    ],
  },
  { label: "Components", links: [["Buttons", "#buttons"]] },
  { label: "Concepts", links: [["Theming", "#theming"]] },
  { label: "About us", links: [["Team", "#team"]] },
  { label: "Contact us", links: [["Contact details", "#contact-details"]] },
] as const;
---

<HamburgerMenu
  defaultOpen={defaultOpen}
  closeOnOutsideClick={closeOnOutsideClick}
>
  <span
    slot="brand"
    class="flex h-8 w-[100px] items-center justify-center rounded-lg bg-muted text-muted-foreground"
  >
    Slot area
  </span>
  <Button
    slot="actions"
    type="button"
    variant="secondary"
    size="icon-sm"
    aria-label="Toggle theme"
  >
    <SemanticIcon name="sun" />
  </Button>
  <Button
    slot="actions"
    as="a"
    href="https://github.com/bejamas"
    variant="secondary"
    size="sm"
    aria-label="Bejamas on GitHub, 220 stars"
  >
    <img
      class="dark:brightness-0 dark:invert"
      src="/figma/hamburger-menu/github-header.svg"
      width="14"
      height="14"
      alt=""
    />
    220
  </Button>

  {withGroups
    ? groups.map(({ label, links }, index) => (
        <MenuGroup label={label} defaultOpen={index === 0}>
          {links.map(([text, href]) => (
            <MenuItem href={href}>{text}</MenuItem>
          ))}
        </MenuGroup>
      ))
    : simpleLinks.map(([text, href]) => (
        <MenuItem href={href}>{text}</MenuItem>
      ))}

  <Button
    slot="footer"
    as="a"
    href="https://x.com/bejamas"
    variant="secondary"
    size="icon"
    aria-label="Bejamas on X"
  >
    <img
      class="dark:brightness-0 dark:invert"
      src="/figma/hamburger-menu/social-x.svg"
      width="16"
      height="16"
      alt=""
    />
  </Button>
  <Button
    slot="footer"
    as="a"
    href="https://github.com/bejamas"
    variant="secondary"
    size="icon"
    aria-label="Bejamas on GitHub"
  >
    <img
      class="dark:brightness-0 dark:invert"
      src="/figma/hamburger-menu/github-footer.svg"
      width="16"
      height="16"
      alt=""
    />
  </Button>
</HamburgerMenu>
