---
import {
  NO_STORE_CACHE_CONTROL,
  SHARED_DYNAMIC_CACHE_CONTROL,
} from "@/utils/http-cache";

let starCount: number | null = null;

Astro.response.headers.set("Cache-Control", NO_STORE_CACHE_CONTROL);

try {
  const response = await fetch("https://api.github.com/repos/bejamas/ui", {
    headers: {
      Accept: "application/vnd.github+json",
      "User-Agent": "bejamas-ui",
      "X-GitHub-Api-Version": "2022-11-28",
    },
  });

  if (response.ok) {
    const data = (await response.json()) as {
      stargazers_count?: unknown;
    };

    if (typeof data.stargazers_count === "number") {
      starCount = data.stargazers_count;
      Astro.response.headers.set("Cache-Control", SHARED_DYNAMIC_CACHE_CONTROL);
    } else {
      console.warn("GitHub stars response did not contain a numeric count");
    }
  } else {
    console.warn("GitHub stars request failed", {
      status: response.status,
      rateLimitRemaining: response.headers.get("x-ratelimit-remaining"),
      rateLimitReset: response.headers.get("x-ratelimit-reset"),
      retryAfter: response.headers.get("retry-after"),
    });
  }
} catch (error) {
  console.warn("GitHub stars request threw", {
    message: error instanceof Error ? error.message : "Unknown error",
  });
}
---

<span
  class="w-8.5 items-center flex justify-center text-center"
  data-github-stars-display
  data-github-stars-value={starCount !== null ? String(starCount) : undefined}
>
  {starCount !== null ? starCount.toLocaleString() : "—"}
</span>
