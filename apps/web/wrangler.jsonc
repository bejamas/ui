{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "bejamas-ui",
  "account_id": "705e6a1ce1620c4ac2ce279a064dec41",
  "compatibility_date": "2026-08-31",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
    "html_handling": "drop-trailing-slash",
  },
  "images": {
    "binding": "IMAGES",
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.1,
    },
  },
}
