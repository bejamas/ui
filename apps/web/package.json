{
  "name": "@bejamas/web",
  "type": "module",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "bun run scripts/dev.ts",
    "dev:artifacts": "BEJAMAS_DEV_BUILD_ARTIFACTS=1 bun run scripts/dev.ts",
    "dev:docs": "BEJAMAS_DEV_BUILD_DOCS=1 bun run scripts/dev.ts",
    "start": "astro dev",
    "build": "bun run build:full",
    "build:fast": "bun run build:artifacts && astro build",
    "build:full": "bun run build:artifacts && bun run build:docs && astro build",
    "build:artifacts": "bun run build:compiled-styles && bun run build:style-registry && bun run build:registry && bun run normalize-component-paths-in-registry",
    "preview": "astro preview",
    "astro": "astro",
    "watch:style-artifacts": "bun run scripts/watch-style-artifacts.ts",
    "build:compiled-styles": "bun run ../../packages/create-config/scripts/generate-compiled-style-css.ts",
    "build:style-registry": "bun run ../../packages/registry/scripts/build-web-style-registry.ts",
    "generate:ui-package": "bun run ../../packages/ui/scripts/generate-from-style-registry.ts",
    "build:registry": "bun x shadcn build",
    "build:docs": "bun x bejamas@canary docs:build",
    "normalize-component-paths-in-registry": "bun run scripts/normalize-paths.ts",
    "check-types": "wrangler types --include-runtime false && astro check",
    "deploy:cloudflare": "bun run build && wrangler deploy"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.73",
    "@astrojs/alpinejs": "1.0.0",
    "@astrojs/check": "0.9.10",
    "@astrojs/cloudflare": "14.3.3",
    "@astrojs/mdx": "8.0.2",
    "@astrojs/sitemap": "3.7.4",
    "@astrojs/starlight": "^0.42.3",
    "@astrojs/starlight-tailwind": "5.0.0",
    "@bejamas/create-config": "workspace:*",
    "@bejamas/registry": "workspace:*",
    "@bejamas/semantic-icons": "workspace:*",
    "@bejamas/ui": "workspace:*",
    "@bruits/satteri-wasm32-wasi": "0.10.5",
    "@expressive-code/plugin-line-numbers": "^0.44.2",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/figtree": "^5.3.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/lora": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/merriweather": "^5.3.0",
    "@fontsource-variable/montserrat": "^5.3.0",
    "@fontsource-variable/noto-sans": "^5.3.0",
    "@fontsource-variable/noto-serif": "^5.3.0",
    "@fontsource-variable/nunito-sans": "^5.3.0",
    "@fontsource-variable/outfit": "^5.3.0",
    "@fontsource-variable/oxanium": "^5.3.0",
    "@fontsource-variable/playfair-display": "^5.3.0",
    "@fontsource-variable/public-sans": "^5.3.0",
    "@fontsource-variable/raleway": "^5.3.0",
    "@fontsource-variable/roboto": "^5.3.0",
    "@fontsource-variable/roboto-slab": "^5.3.0",
    "@fontsource-variable/source-sans-3": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@hotwired/stimulus": "^3.2.2",
    "@lucide/astro": "^1.47.0",
    "@pagefind/default-ui": "^1.5.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/alpinejs": "^3.13.11",
    "@upstash/redis": "^1.39.0",
    "ai": "^7.0.112",
    "alpinejs": "^3.17.4",
    "astro": "7.3.4",
    "astro-robots-txt": "^1.0.0",
    "class-variance-authority": "^0.7.1",
    "culori": "^4.0.2",
    "expressive-code-collapsible": "^1.0.0",
    "nanoid": "^6.0.1",
    "prismjs": "^1.30.0",
    "shadcn": "4.21.0",
    "sharp": "^0.35.4",
    "starlight-theme-bejamas": "workspace:*",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/culori": "^4.0.1",
    "@types/prismjs": "^1.26.6",
    "tw-animate-css": "^1.4.0"
  }
}
