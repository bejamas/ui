{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "lib": ["ES2020"]
  },
  "include": [
    "api/**/*",
    "lib/**/*",
    "src/**/*",
    "types/**/*",
    "worker-configuration.d.ts"
  ]
}
